<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<meta name="theme-color" content="#6C63FF">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<meta name="apple-mobile-web-app-title" content="成书笔记">
<link rel="manifest" href="manifest.json">
<link rel="icon" type="image/svg+xml" href="icon.svg">
<title>成书笔记</title>
<script src="pako.min.js"></script>
<style>
* { margin: 0; padding: 0; box-sizing: border-box; -webkit-tap-highlight-color: transparent; }

:root {
  --primary: #6C63FF;
  --primary-light: #EAE8FF;
  --surface: #FFFFFF;
  --bg: #F5F5F7;
  --text: #1A1A2E;
  --text-muted: #888;
  --border: #E8E8ED;
  --radius: 12px;
  --folder-color: #FFB347;
}

body.dark #app {
  --primary: #8B83FF;
  --primary-light: #252240;
  --surface: #1C1C2A;
  --bg: #111118;
  --text: #E4E4F0;
  --text-muted: #8888B0;
  --border: #2E2E42;
}
body.dark .status-bar, body.dark .app-header, body.dark .breadcrumb,
body.dark .search-bar, body.dark .editor-header, body.dark .editor-toolbar,
body.dark .editor-status, body.dark .find-replace-bar { background: var(--surface); }
body.dark #app, body.dark #main-view, body.dark #editor-view { background: var(--bg); }
body.dark .file-item { background: var(--surface); border-color: var(--border); }
body.dark .file-item:active { background: var(--primary-light); }
body.dark .btn-back, body.dark .btn-icon { background: var(--primary-light); color: var(--primary); }
body.dark .tb-btn { background: var(--surface); border-color: var(--border); color: var(--text); }
body.dark .tb-btn:active { background: var(--primary-light); border-color: var(--primary); color: var(--primary); }
body.dark #note-content { background: transparent; color: var(--text); }
body.dark #note-content:empty::before { color: #888; }
body.dark .note-title-input { color: var(--text); }
body.dark .note-title-input::placeholder { color: #888; }
body.dark .search-input { background: var(--bg); color: var(--text); }
body.dark .search-input::placeholder { color: #888; }
body.dark .modal-sheet { background: var(--surface); }
body.dark .modal-input { background: var(--bg); color: var(--text); border-color: var(--border); }
body.dark .modal-btn.cancel { background: var(--bg); color: var(--text); }
body.dark .fr-btn { background: var(--surface); border-color: var(--border); color: var(--text); }
body.dark .find-replace-bar input { background: var(--bg); color: var(--text); border-color: var(--border); }
body.dark .ctx-bottom { background: var(--surface); }
body.dark .ctx-bottom .ctx-item:active { background: var(--bg); }
body.dark .ctx-handle { background: #555; }
body.dark .bc-current { color: var(--text); }
body.dark .toast { background: rgba(255,255,255,0.15); }
body.dark .recent-chip { background: var(--surface); border-color: var(--border); color: var(--text); }
body.dark .file-list mark { color: #111; }
body.dark .ctx-overlay { background: rgba(0,0,0,0.6); }
body.dark .sel-checkbox { border-color: #666; }
html, body {
  height: 100%;
  font-family: -apple-system, 'PingFang SC', 'Microsoft YaHei', sans-serif;
  background: var(--bg);
  color: var(--text);
  overflow: hidden;
}

#app {
  display: flex; flex-direction: column;
  height: 100vh; max-width: 430px; margin: 0 auto;
  background: var(--bg); position: relative; overflow: hidden;
  box-shadow: 0 0 40px rgba(0,0,0,0.15);
}

#main-view { display: flex; flex-direction: column; flex: 1; min-height: 0; position: relative; }

.status-bar {
  display: flex; justify-content: space-between; align-items: center;
  padding: 8px 20px 4px; font-size: 12px; font-weight: 600;
  color: var(--text); background: var(--surface); flex-shrink: 0;
}
.status-time { font-size: 15px; font-weight: 700; }

.app-header {
  display: flex; align-items: center; padding: 10px 16px;
  background: var(--surface); border-bottom: 1px solid var(--border);
  gap: 10px; flex-shrink: 0; min-height: 52px;
}
.btn-back {
  width: 34px; height: 34px; border-radius: 50%;
  background: var(--bg); border: none; font-size: 18px; cursor: pointer;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0; color: var(--primary);
}
.btn-back:active { background: var(--primary-light); }
.header-title {
  flex: 1; font-size: 17px; font-weight: 700; color: var(--text);
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.header-actions { display: flex; gap: 6px; flex-shrink: 0; }
.btn-icon {
  width: 34px; height: 34px; border-radius: 50%;
  background: var(--bg); border: none; font-size: 18px; cursor: pointer;
  display: flex; align-items: center; justify-content: center;
  color: var(--primary); transition: background 0.15s; position: relative;
}
.btn-icon:active { background: var(--primary-light); }

.breadcrumb {
  display: flex; align-items: center; padding: 8px 16px;
  background: var(--surface); border-bottom: 1px solid var(--border);
  gap: 4px; overflow-x: auto; flex-shrink: 0; scrollbar-width: none;
}
.breadcrumb::-webkit-scrollbar { display: none; }
.bc-item {
  font-size: 13px; color: var(--primary); white-space: nowrap;
  cursor: pointer; padding: 2px 4px; border-radius: 4px;
}
.bc-item:active { background: var(--primary-light); }
.bc-sep { font-size: 12px; color: var(--text-muted); }
.bc-current { color: var(--text); font-weight: 500; }

.file-list {
  flex: 1; overflow-y: auto; -webkit-overflow-scrolling: touch;
  padding: 12px; display: flex; flex-direction: column; gap: 8px;
}
.file-list::-webkit-scrollbar { width: 4px; }
.file-list::-webkit-scrollbar-thumb { background: #ccc; border-radius: 4px; }

.file-item {
  display: flex; align-items: center; padding: 12px 14px;
  background: var(--surface); border-radius: var(--radius);
  border: 1px solid var(--border); cursor: pointer; gap: 12px;
  transition: all 0.15s; position: relative; user-select: none;
}
.file-item:active { transform: scale(0.98); background: #F8F8FC; }
.file-item.folder { border-left: 3px solid var(--folder-color); }
.file-item.note { border-left: 3px solid var(--primary); }
.file-item.pinned { border-left: 3px solid #FFD700 !important; }

.item-icon { font-size: 26px; flex-shrink: 0; width: 36px; text-align: center; }
.item-info { flex: 1; min-width: 0; }
.item-name {
  font-size: 15px; font-weight: 500; color: var(--text);
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.item-meta { font-size: 12px; color: var(--text-muted); margin-top: 2px; }
.item-actions {
  opacity: 0.5; font-size: 20px; padding: 4px;
  cursor: pointer; color: var(--text-muted); flex-shrink: 0;
}
.item-actions:active { opacity: 1; }

.file-list mark {
  background: #FFEB3B; color: #1A1A2E; border-radius: 2px;
  padding: 1px 3px; font-weight: 600;
}

.empty-state {
  display: flex; flex-direction: column; align-items: center;
  justify-content: center; padding: 60px 20px;
  color: var(--text-muted); gap: 12px;
}
.empty-icon { font-size: 56px; }
.empty-text { font-size: 15px; font-weight: 500; color: #aaa; }
.empty-sub { font-size: 13px; color: #bbb; text-align: center; }

.fab-container {
  position: absolute; bottom: 24px; right: 20px;
  display: flex; flex-direction: column; align-items: flex-end;
  gap: 10px; z-index: 10; transition: none;
}
.fab-container.dragging { opacity: 0.85; z-index: 100; }
.fab-container.dragging .fab-main { transform: scale(1.1); }
.fab-menu {
  display: flex; flex-direction: column; gap: 10px; align-items: flex-end;
  transition: all 0.25s; overflow: hidden; max-height: 0; opacity: 0;
}
.fab-menu.open { max-height: 300px; opacity: 1; }
.fab-sub { display: flex; align-items: center; gap: 10px; }
.fab-label {
  background: rgba(0,0,0,0.7); color: white; font-size: 13px;
  padding: 5px 10px; border-radius: 20px; white-space: nowrap;
}
.fab-btn {
  width: 46px; height: 46px; border-radius: 50%; border: none;
  cursor: pointer; font-size: 22px;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 4px 14px rgba(0,0,0,0.2); transition: transform 0.15s;
}
.fab-btn:active { transform: scale(0.92); }
.fab-main {
  width: 54px; height: 54px; border-radius: 50%;
  background: var(--primary); border: none; color: white; font-size: 26px;
  cursor: pointer; display: flex; align-items: center; justify-content: center;
  box-shadow: 0 6px 20px rgba(108,99,255,0.45); transition: transform 0.2s; z-index: 11;
}
.fab-main:active { transform: scale(0.92); }
.fab-main.open { transform: rotate(45deg); }

.quick-back {
  position: absolute; bottom: 100px; right: 20px;
  width: 40px; height: 40px; border-radius: 50%;
  background: rgba(0,0,0,0.55); border: none; color: white;
  font-size: 22px; cursor: pointer; display: none;
  align-items: center; justify-content: center; z-index: 9;
  box-shadow: 0 3px 12px rgba(0,0,0,0.2); transition: all 0.15s;
}
.quick-back.show { display: flex; }
.quick-back:active { transform: scale(0.9); background: var(--primary); }

/* RECENT */
.recent-section { padding: 4px 12px 0; flex-shrink: 0; }
.recent-label { font-size: 11px; color: var(--text-muted); font-weight: 600; margin-bottom: 4px; }
.recent-scroll { display: flex; gap: 8px; overflow-x: auto; padding-bottom: 4px; scrollbar-width: none; }
.recent-scroll::-webkit-scrollbar { display: none; }
.recent-chip {
  flex-shrink: 0; padding: 6px 12px; border-radius: 16px;
  background: var(--surface); border: 1px solid var(--border);
  font-size: 12px; color: var(--text); cursor: pointer;
  white-space: nowrap; max-width: 140px; overflow: hidden; text-overflow: ellipsis;
}

/* SEARCH */
.search-bar {
  padding: 8px 12px; background: var(--surface);
  border-bottom: 1px solid var(--border); flex-shrink: 0;
}
.search-wrap { position: relative; }
.search-icon {
  position: absolute; left: 12px; top: 50%;
  transform: translateY(-50%); font-size: 15px;
  color: var(--text-muted); pointer-events: none;
}
.search-input {
  width: 100%; padding: 8px 14px 8px 36px; border-radius: 20px;
  border: 1px solid var(--border); font-size: 14px;
  background: var(--bg); color: var(--text); outline: none; font-family: inherit;
}
.search-input:focus { border-color: var(--primary); }

/* EDITOR */
#editor-view {
  display: none; flex-direction: column; height: 100vh;
  position: absolute; top: 0; left: 0; right: 0; bottom: 0;
  z-index: 20; background: var(--bg);
}
#editor-view.active { display: flex; }

.editor-header {
  display: flex; align-items: flex-start; padding: 10px 16px;
  gap: 10px; flex-shrink: 0; border-bottom: 1px solid var(--border);
  min-height: 52px; background: var(--surface);
}
.note-title-input {
  flex: 1; border: none; background: transparent;
  font-size: 17px; font-weight: 700; color: var(--text);
  outline: none; font-family: inherit; resize: none; overflow: hidden;
  min-height: 24px; max-height: 120px; line-height: 1.4; padding: 4px 0;
}
.note-title-input::placeholder { color: #bbb; }

.editor-toolbar {
  display: flex; align-items: center; padding: 6px 10px; gap: 4px;
  overflow-x: auto; flex-shrink: 0; border-bottom: 1px solid var(--border);
  scrollbar-width: none; flex-wrap: wrap; background: var(--surface);
}
.editor-toolbar::-webkit-scrollbar { display: none; }
.toolbar-sep { width: 1px; height: 20px; background: var(--border); margin: 0 2px; flex-shrink: 0; }

.tb-btn {
  height: 30px; padding: 0 8px; border-radius: 8px;
  border: 1px solid var(--border); background: var(--surface);
  font-size: 13px; cursor: pointer; color: var(--text);
  display: flex; align-items: center; justify-content: center;
  gap: 4px; white-space: nowrap; transition: all 0.15s; flex-shrink: 0;
}
.tb-btn:active, .tb-btn.active {
  background: var(--primary-light); border-color: var(--primary); color: var(--primary);
}

.editor-area { flex: 1; overflow: hidden; }
#note-content {
  width: 100%; height: 100%; border: none; outline: none;
  padding: 16px; font-size: 15px; line-height: 1.7; color: var(--text);
  background: transparent; font-family: inherit; overflow-y: auto;
  white-space: pre-wrap; word-wrap: break-word;
}
#note-content:empty::before {
  content: '开始书写你的想法…'; color: #bbb;
}
#note-content mark {
  background: #FFEB3B; color: #1A1A2E; border-radius: 2px; padding: 0 1px;
}
#note-content mark.current {
  background: #FF6B35; color: white; border-radius: 2px; padding: 0 1px;
}

/* FIND & REPLACE */
.find-replace-bar {
  display: none; flex-wrap: wrap; align-items: center; gap: 6px;
  padding: 6px 10px; background: var(--surface);
  border-bottom: 1px solid var(--border); flex-shrink: 0;
}
.find-replace-bar.show { display: flex; }
.find-replace-bar input {
  height: 30px; padding: 0 8px; border-radius: 8px;
  border: 1px solid var(--border); font-size: 13px;
  background: var(--bg); color: var(--text); outline: none;
  font-family: inherit; min-width: 60px; flex: 1;
}
.find-replace-bar input:focus { border-color: var(--primary); }
.fr-btn {
  height: 30px; padding: 0 8px; border-radius: 8px;
  border: 1px solid var(--border); background: var(--surface);
  font-size: 12px; cursor: pointer; color: var(--text);
  white-space: nowrap; flex-shrink: 0;
}
.fr-btn:active { background: var(--primary-light); }
.fr-count { font-size: 12px; color: var(--text-muted); min-width: 30px; text-align: center; flex-shrink: 0; }

.editor-status {
  padding: 6px 16px; font-size: 12px; color: var(--text-muted);
  background: var(--surface); border-top: 1px solid var(--border);
  display: flex; justify-content: space-between; flex-shrink: 0;
}

/* MODAL */
.modal-overlay {
  display: none; position: absolute; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5); z-index: 50;
  align-items: flex-end; justify-content: center;
}
.modal-overlay.show { display: flex; }
.modal-sheet {
  background: var(--surface); border-radius: 20px 20px 0 0;
  padding: 20px; width: 100%; animation: slideUp 0.3s ease;
  max-height: 85vh; overflow-y: auto;
}
@keyframes slideUp { from { transform: translateY(100%); } to { transform: translateY(0); } }
.modal-title { font-size: 16px; font-weight: 700; margin-bottom: 16px; text-align: center; color: var(--text); }
.modal-input {
  width: 100%; padding: 12px 16px; border-radius: 12px;
  border: 1px solid var(--border); font-size: 15px; color: var(--text);
  background: var(--bg); outline: none; font-family: inherit; margin-bottom: 14px;
}
.modal-input:focus { border-color: var(--primary); }
.modal-btns { display: flex; gap: 10px; }
.modal-btn {
  flex: 1; padding: 12px; border-radius: 12px; border: none;
  font-size: 15px; font-weight: 600; cursor: pointer; transition: opacity 0.15s;
}
.modal-btn:active { opacity: 0.8; }
.modal-btn.cancel { background: var(--bg); color: var(--text); }
.modal-btn.confirm { background: var(--primary); color: white; }

/* TOAST */
.toast {
  position: absolute; bottom: 90px; left: 50%;
  transform: translateX(-50%) translateY(20px);
  background: rgba(0,0,0,0.75); color: white;
  padding: 10px 20px; border-radius: 24px; font-size: 14px;
  z-index: 100; opacity: 0; transition: all 0.3s;
  white-space: nowrap; pointer-events: none;
}
.toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }

/* MOVE FOLDER DIALOG */
.folder-pick-list { max-height: 240px; overflow-y: auto; margin-bottom: 12px; }
.folder-pick-item {
  display: flex; align-items: center; gap: 10px; padding: 10px 12px;
  border-radius: 10px; cursor: pointer; font-size: 14px; color: var(--text);
}
.folder-pick-item:active { background: var(--primary-light); }

.pin-badge { font-size: 12px; margin-left: 4px; flex-shrink: 0; }

/* FOCUS MODE */
#editor-view.focus-mode .editor-header,
#editor-view.focus-mode .editor-toolbar,
#editor-view.focus-mode .editor-status,
#editor-view.focus-mode .find-replace-bar { display: none; }
#editor-view.focus-mode .editor-area { padding-top: 20px; }
.focus-exit-btn {
  display: none; position: fixed; bottom: 30px; right: 24px;
  width: 44px; height: 44px; border-radius: 50%; z-index: 100;
  background: var(--primary); color: white; border: none;
  font-size: 18px; cursor: pointer; box-shadow: 0 4px 16px rgba(108,99,255,0.5);
  align-items: center; justify-content: center;
}
.focus-exit-btn.show { display: flex; }
.focus-exit-btn:active { transform: scale(0.92); }

/* GRID VIEW */
.grid-mode .file-list { flex-direction: row; flex-wrap: wrap; gap: 8px; align-items: stretch; }
.grid-mode .file-item {
  flex-direction: column; width: calc(50% - 4px); min-width: 0;
  padding: 14px 10px; gap: 8px; align-items: flex-start;
}
.grid-mode .file-item .item-icon { font-size: 32px; width: auto; }
.grid-mode .file-item .item-info { width: 100%; }
.grid-mode .file-item .item-actions {
  position: absolute; top: 6px; right: 8px; font-size: 16px;
}
.grid-mode .file-item .item-name {
  white-space: normal; display: -webkit-box;
  -webkit-line-clamp: 2; -webkit-box-orient: vertical;
  overflow: hidden; font-size: 14px; line-height: 1.3;
}
.grid-mode .sel-checkbox {
  position: absolute; top: 6px; left: 8px; z-index: 2;
}

/* MULTI-SELECT */
.ctx-overlay {
  display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.4); z-index: 80;
}
.ctx-overlay.show { display: block; }
.ctx-bottom {
  position: fixed; bottom: 0; left: 50%; transform: translateX(-50%) translateY(100%);
  max-width: 430px; width: 100%;
  background: var(--surface); border-radius: 20px 20px 0 0;
  z-index: 81; padding: 8px 0 20px;
  transition: transform 0.3s ease;
  box-shadow: 0 -4px 24px rgba(0,0,0,0.15);
}
.ctx-bottom.show { transform: translateX(-50%) translateY(0); }
.ctx-bottom .ctx-title {
  font-size: 13px; color: var(--text-muted);
  text-align: center; padding: 8px 0 4px; margin-bottom: 4px;
}
.ctx-bottom .ctx-item {
  padding: 14px 24px; font-size: 15px; cursor: pointer; color: var(--text);
  display: flex; align-items: center; gap: 12px;
}
.ctx-bottom .ctx-item:active { background: var(--bg); }
.ctx-bottom .ctx-item.danger { color: #E24B4A; }
.ctx-handle {
  width: 36px; height: 4px; background: #ccc; border-radius: 2px;
  margin: 0 auto 8px;
}

/* MULTI-SELECT */
.select-mode .file-item { padding-left: 10px; transition: all 0.15s; }
.sel-checkbox {
  display: none; width: 24px; height: 24px; border-radius: 50%;
  border: 2.5px solid #999; flex-shrink: 0; margin-right: 8px;
  align-items: center; justify-content: center; font-size: 14px; font-weight: 700;
  color: transparent; transition: all 0.15s; background: white;
}
.select-mode .sel-checkbox { display: flex; }
.sel-checkbox.checked {
  background: #4CAF50 !important; border-color: #388E3C !important;
  color: white !important; transform: scale(1.1);
}
.select-mode .file-item.selected {
  background: #C8E6C9 !important;
  border: 2px solid #4CAF50 !important;
  border-left: 5px solid #4CAF50 !important;
}
body.dark .select-mode .file-item.selected {
  background: #1B5E20 !important;
  border: 2px solid #66BB6A !important;
  border-left: 5px solid #66BB6A !important;
}
body.dark .sel-checkbox { border-color: #888; background: #333; }
body.dark .sel-checkbox.checked {
  background: #4CAF50 !important; border-color: #66BB6A !important; color: white !important;
}
.sel-toolbar {
  display: none; align-items: center; justify-content: space-around;
  padding: 10px 16px; background: var(--surface);
  border-top: 1px solid var(--border); flex-shrink: 0; gap: 8px;
}
.sel-toolbar.show { display: flex; }
.sel-toolbar button {
  flex: 1; padding: 10px 8px; border-radius: 10px; border: 1px solid var(--border);
  background: var(--surface); font-size: 13px; cursor: pointer; color: var(--text);
  display: flex; align-items: center; justify-content: center; gap: 4px;
}
.sel-toolbar button:active { background: var(--primary-light); }
.sel-toolbar button.danger { color: #E24B4A; border-color: #E24B4A; }
.select-mode .fab-container { display: none; }
.sel-count { font-size: 13px; color: var(--text-muted); text-align: center; padding: 4px 0; }
/* EXPORT PATH */
.export-path-row {
  display: flex; align-items: center; gap: 8px;
  background: var(--bg); border-radius: 10px; padding: 10px 14px;
  margin-bottom: 14px; font-size: 13px; color: var(--text-muted);
  word-break: break-all;
}
</style>
</head>
<body>

<div id="app">

  <!-- STATUS BAR -->
  <div class="status-bar">
    <span class="status-time" id="clock">18:34</span>
    <span style="font-size:13px">●●● WiFi 🔋</span>
  </div>

  <!-- MAIN FILE VIEW -->
  <div id="main-view">
    <div class="app-header">
      <button class="btn-back" id="btn-back" style="visibility:hidden">‹</button>
      <span class="header-title" id="header-title">成书笔记</span>
      <div class="header-actions">
        <button class="btn-icon" id="btn-select-mode" title="多选">☑</button>
        <button class="btn-icon" id="btn-dark-mode" title="暗色模式">🌙</button>
        <button class="btn-icon" id="btn-export-all" title="导出全部为DOCX文档">💾</button>
        <button class="btn-icon" id="btn-sort" title="排序" style="font-size:12px;width:auto;padding:0 10px;border-radius:16px;">按时间</button>
        <button class="btn-icon" id="btn-grid" title="网格模式" style="font-size:14px">⊞</button>
      </div>
    </div>

    <div class="breadcrumb" id="breadcrumb">
      <span class="bc-item bc-current" data-id="root">全部</span>
    </div>

    <div class="search-bar">
      <div class="search-wrap">
        <span class="search-icon">🔍</span>
        <input class="search-input" id="search-input" placeholder="搜索便签…" type="search">
      </div>
    </div>

    <div class="recent-section" id="recent-section">
      <div class="recent-label">🕐 最近打开</div>
      <div class="recent-scroll" id="recent-scroll"></div>
    </div>

    <div class="file-list" id="file-list"></div>

    <div class="sel-count" id="sel-count" style="display:none">已选 0 项</div>
    <div class="sel-toolbar" id="sel-toolbar">
      <button id="sel-share">📤 分享</button>
      <button id="sel-export">💾 导出</button>
      <button id="sel-move">📁 移动</button>
      <button class="danger" id="sel-delete">🗑 删除</button>
      <button id="sel-cancel">✕ 取消</button>
    </div>

    <button class="quick-back" id="quick-back" title="返回上级">‹</button>

    <div class="fab-container" id="fab-container">
      <div class="fab-menu" id="fab-menu">
        <div class="fab-sub">
          <span class="fab-label">新建笔记</span>
          <button class="fab-btn" id="btn-new-note" style="background:#6C63FF;color:white">📝</button>
        </div>
        <div class="fab-sub">
          <span class="fab-label">新建文件夹</span>
          <button class="fab-btn" id="btn-new-folder" style="background:#FFB347;color:white">📁</button>
        </div>
      </div>
      <button class="fab-main" id="fab-main">+</button>
    </div>
  </div>

  <!-- EDITOR VIEW -->
  <div id="editor-view">
    <div class="editor-header">
      <button class="btn-back" id="editor-back">‹</button>
      <textarea class="note-title-input" id="note-title" placeholder="无标题" rows="1" autocomplete="off"></textarea>
      <div class="header-actions">
        <button class="btn-icon" id="btn-focus-mode" title="专注模式">🎯</button>
        <button class="btn-icon" id="btn-find-replace" title="查找替换">🔍</button>
        <button class="btn-icon" id="btn-ocr" title="📷 扫描图片文字（OCR）">📷</button>
      </div>
    </div>

    <div class="find-replace-bar" id="find-replace-bar">
      <input type="text" id="fr-find" placeholder="查找…">
      <input type="text" id="fr-replace" placeholder="替换为…">
      <button class="fr-btn" id="fr-prev">◀</button>
      <button class="fr-btn" id="fr-next">▶</button>
      <span class="fr-count" id="fr-count"></span>
      <button class="fr-btn" id="fr-replace-one">替换</button>
      <button class="fr-btn" id="fr-replace-all">全部替换</button>
      <button class="fr-btn" id="fr-close" style="color:#E24B4A">✕</button>
    </div>

    <div class="editor-toolbar" id="editor-toolbar">
      <button class="tb-btn" id="font-dec">－</button>
      <span style="font-size:12px;color:var(--text);min-width:22px;text-align:center" id="font-size-val">15</span>
      <button class="tb-btn" id="font-inc">＋</button>
      <span class="toolbar-sep"></span>
      <button class="tb-btn" id="tb-bold"><b>B</b></button>
      <button class="tb-btn" id="tb-italic"><i>I</i></button>
      <button class="tb-btn" id="tb-underline"><u>U</u></button>
    </div>

    <div class="editor-area">
      <div id="note-content" contenteditable="true"></div>
    </div>

    <div class="editor-status">
      <span id="editor-info">0 字</span>
      <span id="save-status">未保存</span>
    </div>

    <button class="quick-back show" id="editor-quick-back" title="返回列表" style="bottom:20px;right:24px;z-index:21;">←</button>
    <button class="focus-exit-btn" id="focus-exit-btn" title="退出专注模式">✕</button>
  </div>

  <!-- NAME MODAL -->
  <div class="modal-overlay" id="name-modal">
    <div class="modal-sheet">
      <div class="modal-title" id="name-modal-title">新建文件夹</div>
      <input class="modal-input" id="name-input" placeholder="输入名称…" maxlength="50">
      <div class="modal-btns">
        <button class="modal-btn cancel" id="name-cancel">取消</button>
        <button class="modal-btn confirm" id="name-confirm">创建</button>
      </div>
    </div>
  </div>

  <!-- CONTEXT BOTTOM SHEET -->
  <div class="ctx-overlay" id="ctx-overlay"></div>
  <div class="ctx-bottom" id="ctx-bottom">
    <div class="ctx-handle"></div>
    <div class="ctx-title" id="ctx-bottom-title">操作</div>
    <div class="ctx-item" id="ctxb-rename">✏️ 重命名</div>
    <div class="ctx-item" id="ctxb-pin">📌 置顶</div>
    <div class="ctx-item" id="ctxb-share">📤 分享</div>
    <div class="ctx-item" id="ctxb-export">💾 导出为 TXT</div>
    <div class="ctx-item" id="ctxb-export-docx">📄 导出为 DOCX</div>
    <div class="ctx-item" id="ctxb-move">📁 移动到…</div>
    <div class="ctx-item danger" id="ctxb-delete">🗑️ 删除</div>
    <div class="ctx-item" id="ctxb-cancel" style="justify-content:center;color:var(--text-muted);border-top:1px solid var(--border);margin-top:4px;padding-top:14px">取消</div>
  </div>

  <!-- RENAME MODAL -->
  <div class="modal-overlay" id="rename-modal">
    <div class="modal-sheet">
      <div class="modal-title">重命名</div>
      <input class="modal-input" id="rename-input" placeholder="输入新名称…" maxlength="50">
      <div class="modal-btns">
        <button class="modal-btn cancel" id="rename-cancel">取消</button>
        <button class="modal-btn confirm" id="rename-confirm">确认</button>
      </div>
    </div>
  </div>

  <!-- MOVE TO FOLDER MODAL -->
  <div class="modal-overlay" id="move-modal">
    <div class="modal-sheet">
      <div class="modal-title">移动到文件夹</div>
      <div class="folder-pick-list" id="folder-pick-list"></div>
      <button class="modal-btn cancel" id="move-cancel" style="width:100%">取消</button>
    </div>
  </div>

  <!-- TOAST -->
  <div class="toast" id="toast"></div>

</div>

<script>
// ===================== DATA STORE =====================
function isCapacitor() { return typeof Capacitor !== 'undefined' && Capacitor.isNativePlatform && Capacitor.isNativePlatform(); }

const STORAGE_KEY = 'phone_notes_v2';
const RECENT_KEY = 'chengshu_recent';
let store = loadStore();
let currentFolderId = 'root';
let currentNoteId = null;
let fabOpen = false;
let currentFontSize = 15;
let contextTarget = null;
let sortOrder = localStorage.getItem('chengshu_sort') || 'date';
let darkMode = false;
let moveTargetId = null;
let selectMode = false;
let selectedItems = {}; // {id: {type:'note'|'folder', data:...}}

(function() {
  const btn = document.getElementById('btn-sort');
  if (btn) btn.textContent = sortOrder === 'date' ? '按时间' : '按名称';
})();

function loadStore() {
  try { const d = localStorage.getItem(STORAGE_KEY); if (d) return JSON.parse(d); } catch(e) {}
  return {
    folders: { root: { id: 'root', name: '根目录', parent: null, children: [] } },
    notes: {}
  };
}
function saveStore() { localStorage.setItem(STORAGE_KEY, JSON.stringify(store)); }

// ===================== CLOCK =====================
function updateClock() {
  const now = new Date();
  document.getElementById('clock').textContent =
    now.getHours().toString().padStart(2,'0') + ':' + now.getMinutes().toString().padStart(2,'0');
}
updateClock();
setInterval(updateClock, 10000);

// ===================== HELPERS =====================
function genId() { return Date.now().toString(36) + Math.random().toString(36).slice(2,7); }
function escHtml(s) { return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
function formatDate(ts) {
  if (!ts) return '';
  const d = new Date(ts);
  return (d.getMonth()+1).toString().padStart(2,'0') + '/' +
    d.getDate().toString().padStart(2,'0') + ' ' +
    d.getHours().toString().padStart(2,'0') + ':' +
    d.getMinutes().toString().padStart(2,'0');
}
function highlightText(text, query) {
  if (!query || !text) return escHtml(text);
  const escaped = query.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
  return escHtml(text).replace(new RegExp('(' + escaped + ')', 'gi'), '<mark>$1</mark>');
}

function getChildren(folderId) {
  const folder = store.folders[folderId];
  if (!folder) return { folders: [], notes: [] };
  return {
    folders: (folder.children || []).filter(id => store.folders[id]).map(id => store.folders[id]),
    notes: Object.values(store.notes).filter(n => n.parent === folderId)
  };
}

function collectAllFolders() {
  return Object.keys(store.folders).filter(id => id !== 'root').map(id => store.folders[id]);
}

function collectAllNotes() {
  return Object.values(store.notes);
}

function getNoteFolderPath(note) {
  if (!note || !note.parent || note.parent === 'root') return '';
  const path = getPath(note.parent);
  return path.map(p => p.name).join(' › ');
}

// ===================== RENDER FILE LIST =====================
function renderFileList(searchQuery) {
  searchQuery = (searchQuery || '').trim();
  const list = document.getElementById('file-list');
  let items = [];

  if (searchQuery) {
    collectAllFolders().forEach(f => {
      if (f.name.includes(searchQuery)) {
        const childCount = (f.children||[]).length + Object.values(store.notes).filter(n=>n.parent===f.id).length;
        items.push({ type:'folder', data:f, count:childCount });
      }
    });
    collectAllNotes().forEach(n => {
      if (n.title.includes(searchQuery) || n.content.includes(searchQuery))
        items.push({ type:'note', data:n });
    });
    items.sort((a, b) => {
      const da = a.data.updated || a.data.created || 0;
      const db = b.data.updated || b.data.created || 0;
      return db - da;
    });
  } else {
    const { folders, notes } = getChildren(currentFolderId);
    folders.forEach(f => {
      const childCount = (f.children||[]).length + Object.values(store.notes).filter(n=>n.parent===f.id).length;
      items.push({ type:'folder', data:f, count:childCount });
    });
    notes.forEach(n => items.push({ type:'note', data:n }));

    items.sort((a, b) => {
      const aPinned = a.data.pinned ? 0 : 1;
      const bPinned = b.data.pinned ? 0 : 1;
      if (aPinned !== bPinned) return aPinned - bPinned;
      if (a.type !== b.type) return a.type === 'folder' ? -1 : 1;
      if (sortOrder === 'date') {
        const da = a.data.updated || a.data.created || 0;
        const db = b.data.updated || b.data.created || 0;
        if (da !== db) return db - da;
      }
      return (a.data.name || a.data.title || '').localeCompare(b.data.name || b.data.title || '', 'zh-CN', { numeric: true });
    });
  }

  if (!searchQuery) {
    renderRecent();
  } else {
    document.getElementById('recent-section').style.display = 'none';
  }

  if (items.length === 0) {
    list.innerHTML = `<div class="empty-state">
      <div class="empty-icon">${searchQuery ? '🔍' : '📂'}</div>
      <div class="empty-text">${searchQuery ? '未找到匹配内容' : '这里还是空的'}</div>
      <div class="empty-sub">${searchQuery ? '换个关键词试试' : '点击右下角 + 新建便签或文件夹'}</div>
    </div>`;
    return;
  }

  let html = '';
  items.forEach(item => {
    const selClass = (selectMode && selectedItems[item.data.id]) ? ' checked' : '';
    const itemSelClass = (selectMode && selectedItems[item.data.id]) ? ' selected' : '';
    if (item.type === 'folder') {
      const pinned = item.data.pinned ? ' 📌' : '';
      html += `<div class="file-item folder${item.data.pinned ? ' pinned' : ''}${itemSelClass}" data-id="${item.data.id}" data-type="folder">
        <div class="sel-checkbox${selClass}" data-sel="${item.data.id}">✓</div>
        <div class="item-icon">📁</div>
        <div class="item-info">
          <div class="item-name">${searchQuery ? highlightText(item.data.name, searchQuery) : escHtml(item.data.name)}${pinned}</div>
          <div class="item-meta">${item.count} 项内容</div>
        </div>
        <span class="item-actions" data-ctx="${item.data.id}" data-ctx-type="folder">⋯</span>
      </div>`;
    } else {
      const n = item.data;
      const pinnedIcon = n.pinned ? ' 📌' : '';
      let previewText;
      if (searchQuery && n.content) {
        const flat = n.content.replace(/\n/g, ' ');
        const idx = flat.toLowerCase().indexOf(searchQuery.toLowerCase());
        if (idx >= 0) {
          const ctxLen = 30;
          const start = Math.max(0, idx - ctxLen);
          const end = Math.min(flat.length, idx + searchQuery.length + ctxLen);
          previewText = (start > 0 ? '…' : '') + flat.slice(start, end) + (end < flat.length ? '…' : '');
        } else {
          previewText = flat.slice(0, 40);
        }
      } else {
        previewText = n.content ? n.content.replace(/\n/g, ' ').slice(0, 40) : '空白便签';
      }
      const nameHtml = (searchQuery ? highlightText(n.title || '无标题', searchQuery) : escHtml(n.title || '无标题')) + pinnedIcon;
      const previewHtml = searchQuery ? highlightText(previewText, searchQuery) : escHtml(previewText);
      const folderPath = searchQuery ? getNoteFolderPath(n) : '';
      const metaRight = folderPath ? '📁' + escHtml(folderPath) : formatDate(n.updated);
      html += `<div class="file-item note${n.pinned ? ' pinned' : ''}${itemSelClass}" data-id="${n.id}" data-type="note">
        <div class="sel-checkbox${selClass}" data-sel="${n.id}">✓</div>
        <div class="item-icon">📝</div>
        <div class="item-info">
          <div class="item-name">${nameHtml}</div>
          <div class="item-meta">${previewHtml} · ${metaRight}</div>
        </div>
        <span class="item-actions" data-ctx="${n.id}" data-ctx-type="note">⋯</span>
      </div>`;
    }
  });
  list.innerHTML = html;

  // Click handlers
  list.querySelectorAll('.file-item').forEach(el => {
    el.addEventListener('click', function(e) {
      if (selectMode) {
        e.stopPropagation();
        toggleSelectItem(this.dataset.id, this.dataset.type, this);
        return;
      }
      if (e.target.classList.contains('item-actions') || e.target.closest('.item-actions')) {
        e.stopPropagation();
        showBottomSheet(this.dataset.id, this.dataset.type);
        return;
      }
      if (e.target.classList.contains('sel-checkbox') || e.target.closest('.sel-checkbox')) {
        e.stopPropagation();
        toggleSelectItem(this.dataset.id, this.dataset.type, this);
        return;
      }
      if (this.dataset.type === 'folder') openFolder(this.dataset.id);
      else openNote(this.dataset.id);
    });
  });

  if (searchQuery) {
    const firstMark = list.querySelector('mark');
    if (firstMark) setTimeout(() => firstMark.scrollIntoView({ behavior: 'smooth', block: 'center' }), 100);
  }
}

// ===================== NAVIGATION =====================
function openFolder(id) {
  if (selectMode) toggleSelectMode();
  currentFolderId = id;
  const si = document.getElementById('search-input');
  if (si.value.trim()) si.value = '';
  updateHeader();
  updateQuickBack();
  renderFileList();
  closeFab();
}

function updateHeader() {
  const folder = store.folders[currentFolderId];
  document.getElementById('header-title').textContent = currentFolderId === 'root' ? '成书笔记' : folder.name;
  document.getElementById('btn-back').style.visibility = currentFolderId === 'root' ? 'hidden' : 'visible';
  renderBreadcrumb();
}

function renderBreadcrumb() {
  const bc = document.getElementById('breadcrumb');
  const path = getPath(currentFolderId);
  bc.innerHTML = path.map((p, i) => {
    const isLast = i === path.length - 1;
    return (i > 0 ? '<span class="bc-sep">›</span>' : '') +
      `<span class="${isLast ? 'bc-item bc-current' : 'bc-item'}" data-id="${p.id}">${escHtml(p.name)}</span>`;
  }).join('');
  bc.querySelectorAll('.bc-item').forEach(el => el.addEventListener('click', () => openFolder(el.dataset.id)));
  bc.scrollLeft = bc.scrollWidth;
}

function getPath(id) {
  const path = [];
  let current = id;
  while (current) {
    const f = store.folders[current];
    if (!f) break;
    path.unshift({ id: current, name: current === 'root' ? '全部' : f.name });
    current = f.parent;
  }
  return path;
}

document.getElementById('btn-back').addEventListener('click', () => {
  const folder = store.folders[currentFolderId];
  if (folder && folder.parent !== null) openFolder(folder.parent);
});

const quickBack = document.getElementById('quick-back');
function updateQuickBack() {
  quickBack.classList.toggle('show', currentFolderId !== 'root');
}
quickBack.addEventListener('click', () => {
  const folder = store.folders[currentFolderId];
  if (folder && folder.parent !== null) openFolder(folder.parent);
});

// ===================== RECENT =====================
function getRecentNotes() {
  let recent = [];
  try { recent = JSON.parse(localStorage.getItem(RECENT_KEY) || '[]'); } catch(e) {}
  return recent.filter(id => store.notes[id]).slice(0, 5);
}
function renderRecent() {
  const section = document.getElementById('recent-section');
  const scroll = document.getElementById('recent-scroll');
  const recent = getRecentNotes().filter(id => id !== currentNoteId);
  if (recent.length === 0) { section.style.display = 'none'; return; }
  section.style.display = 'block';
  scroll.innerHTML = recent.map(id => {
    const n = store.notes[id];
    return `<div class="recent-chip" onclick="event.stopPropagation();openNote('${id}')">
      📝 ${escHtml(n.title || '无标题')}
    </div>`;
  }).join('');
}

// ===================== PIN =====================
function togglePin(id) {
  const note = store.notes[id];
  const folder = store.folders[id];
  if (note) note.pinned = !note.pinned;
  else if (folder) folder.pinned = !folder.pinned;
  else return;
  saveStore();
  renderFileList(document.getElementById('search-input').value.trim());
}

// ===================== FAB =====================
const fabMain = document.getElementById('fab-main');
const fabMenu = document.getElementById('fab-menu');
function closeFab() { fabOpen = false; fabMenu.classList.remove('open'); fabMain.classList.remove('open'); }
fabMain.addEventListener('click', () => {
  fabOpen = !fabOpen;
  fabMenu.classList.toggle('open', fabOpen);
  fabMain.classList.toggle('open', fabOpen);
});
document.getElementById('file-list').addEventListener('click', closeFab);

// ===================== NEW FOLDER / NOTE =====================
let nameConfirmFn = null;
function showNameModal(title, placeholder, onConfirm) {
  document.getElementById('name-modal-title').textContent = title;
  document.getElementById('name-input').placeholder = placeholder;
  document.getElementById('name-input').value = '';
  nameConfirmFn = onConfirm;
  document.getElementById('name-modal').classList.add('show');
  setTimeout(() => document.getElementById('name-input').focus(), 300);
  closeFab();
}

document.getElementById('btn-new-folder').addEventListener('click', () => {
  showNameModal('新建文件夹', '输入文件夹名称…', createFolder);
});
document.getElementById('btn-new-note').addEventListener('click', () => {
  const id = genId();
  store.notes[id] = {
    id, title: '', content: '', parent: currentFolderId,
    created: Date.now(), updated: Date.now(),
    fontSize: 15
  };
  saveStore();
  openNote(id);
  closeFab();
});

document.getElementById('name-cancel').addEventListener('click', () => document.getElementById('name-modal').classList.remove('show'));
document.getElementById('name-confirm').addEventListener('click', () => {
  const val = document.getElementById('name-input').value.trim();
  if (!val) { document.getElementById('name-input').focus(); return; }
  if (nameConfirmFn) nameConfirmFn(val);
  document.getElementById('name-modal').classList.remove('show');
});
document.getElementById('name-input').addEventListener('keydown', e => { if (e.key==='Enter') document.getElementById('name-confirm').click(); });

function createFolder(name) {
  const id = genId();
  store.folders[id] = { id, name, parent: currentFolderId, children: [] };
  const parent = store.folders[currentFolderId];
  parent.children = parent.children || [];
  parent.children.push(id);
  saveStore();
  renderFileList();
}

// ===================== CONTEXT BOTTOM SHEET =====================
function showBottomSheet(id, type) {
  contextTarget = { id, type };
  const isNote = type === 'note';
  const overlay = document.getElementById('ctx-overlay');
  const sheet = document.getElementById('ctx-bottom');
  const title = document.getElementById('ctx-bottom-title');

  const obj = isNote ? store.notes[id] : store.folders[id];
  title.textContent = obj ? (isNote ? (obj.title || '无标题') : obj.name) : '操作';

  document.getElementById('ctxb-pin').style.display = 'flex';
  if (isNote && store.notes[id]) {
    document.getElementById('ctxb-pin').textContent = store.notes[id].pinned ? '📍 取消置顶' : '📌 置顶';
  } else if (!isNote && store.folders[id]) {
    document.getElementById('ctxb-pin').textContent = store.folders[id].pinned ? '📍 取消置顶' : '📌 置顶';
  }
  document.getElementById('ctxb-move').style.display = isNote ? 'flex' : 'none';
  // 分享与导出：仅便签显示，文件夹隐藏
  document.getElementById('ctxb-share').style.display = isNote ? 'flex' : 'none';
  document.getElementById('ctxb-export').style.display = isNote ? 'flex' : 'none';
  document.getElementById('ctxb-export-docx').style.display = isNote ? 'flex' : 'none';
  document.getElementById('ctxb-share').textContent = '📤 分享';
  overlay.classList.add('show');
  sheet.classList.add('show');
}

function hideBottomSheet() {
  document.getElementById('ctx-overlay').classList.remove('show');
  document.getElementById('ctx-bottom').classList.remove('show');
}

document.getElementById('ctx-overlay').addEventListener('click', hideBottomSheet);
document.getElementById('ctxb-cancel').addEventListener('click', hideBottomSheet);

document.getElementById('ctxb-rename').addEventListener('click', () => {
  hideBottomSheet();
  if (!contextTarget) return;
  const current = contextTarget.type === 'folder'
    ? store.folders[contextTarget.id].name
    : store.notes[contextTarget.id].title;
  document.getElementById('rename-input').value = current || '';
  document.getElementById('rename-modal').classList.add('show');
  setTimeout(() => document.getElementById('rename-input').focus(), 300);
});

document.getElementById('ctxb-share').addEventListener('click', () => {
  hideBottomSheet();
  if (!contextTarget) return;
  if (contextTarget.type === 'note') shareNote(contextTarget.id);
  else shareFolder(contextTarget.id);
});

document.getElementById('ctxb-export').addEventListener('click', function() {
  hideBottomSheet();
  if (!contextTarget) return;
  if (contextTarget.type === 'note') {
    var n = store.notes[contextTarget.id];
    if (!n) return;
    showExportConfirmDialog(
      n.title || '无标题',
      (n.title || '便签') + '.txt',
      (function(id) { return function() {
        var nn = store.notes[id];
        return (nn.title || '无标题') + '\n\n' + (nn.content || '');
      }; })(contextTarget.id),
      'txt'
    );
  } else {
    exportFolderTxt(contextTarget.id);
  }
});

document.getElementById('ctxb-export-docx').addEventListener('click', function() {
  hideBottomSheet();
  if (!contextTarget) return;
  if (contextTarget.type === 'note') {
    var n2 = store.notes[contextTarget.id];
    if (!n2) return;
    showExportConfirmDialog(
      n2.title || '无标题',
      (n2.title || '便签') + '.docx',
      (function(id) { return function() {
        var nn = store.notes[id];
        return [{ title: nn.title || '无标题', content: nn.content || '', time: '创建：' + new Date(nn.created || Date.now()).toLocaleString('zh-CN') }];
      }; })(contextTarget.id),
      'docx'
    );
  } else {
    var folder2 = store.folders[contextTarget.id];
    if (!folder2) return;
    var notes2 = collectFolderNotes(contextTarget.id);
    if (notes2.length === 0) { showToast('文件夹内没有便签可导出'); return; }
    var paras2 = notes2.map(function(n) {
      return { title: n.title || '无标题', content: n.content || '', time: '时间：' + new Date(n.updated || n.created).toLocaleString('zh-CN') };
    });
    showExportConfirmDialog(
      folder2.name + '（' + notes2.length + ' 条便签）',
      folder2.name + '_导出.docx',
      function() { return paras2; },
      'docx'
    );
  }
});

document.getElementById('ctxb-pin').addEventListener('click', () => {
  hideBottomSheet();
  if (contextTarget) togglePin(contextTarget.id);
});

document.getElementById('ctxb-move').addEventListener('click', () => {
  hideBottomSheet();
  if (contextTarget && contextTarget.type === 'note') showMoveModal(contextTarget.id);
});

document.getElementById('ctxb-delete').addEventListener('click', () => {
  hideBottomSheet();
  if (!contextTarget) return;
  if (contextTarget.type === 'folder') { deleteFolder(contextTarget.id); renderFileList(); }
  else { delete store.notes[contextTarget.id]; saveStore(); renderFileList(); showToast('已删除'); }
});

document.getElementById('rename-cancel').addEventListener('click', () => document.getElementById('rename-modal').classList.remove('show'));
document.getElementById('rename-confirm').addEventListener('click', () => {
  const val = document.getElementById('rename-input').value.trim();
  if (!val) return;
  if (contextTarget.type === 'folder') store.folders[contextTarget.id].name = val;
  else { store.notes[contextTarget.id].title = val; store.notes[contextTarget.id].updated = Date.now(); }
  saveStore();
  renderFileList();
  document.getElementById('rename-modal').classList.remove('show');
  updateHeader();
});
document.getElementById('rename-input').addEventListener('keydown', e => { if (e.key==='Enter') document.getElementById('rename-confirm').click(); });

function deleteFolder(id) {
  const folder = store.folders[id];
  if (!folder) return;
  (folder.children || []).forEach(cid => deleteFolder(cid));
  Object.values(store.notes).filter(n=>n.parent===id).forEach(n => delete store.notes[n.id]);
  if (folder.parent && store.folders[folder.parent])
    store.folders[folder.parent].children = (store.folders[folder.parent].children||[]).filter(c=>c!==id);
  delete store.folders[id];
  saveStore();
}

// ===================== MOVE =====================
function showMoveModal(id) {
  moveTargetId = id;
  document.getElementById('move-modal').classList.add('show');
  renderFolderPickList();
}
function renderFolderPickList() {
  const list = document.getElementById('folder-pick-list');
  const all = flattenFolders();
  list.innerHTML = all.map(f => {
    const depth = f.path.length - 1;
    const indent = ' '.repeat(depth);
    const isCurrent = store.notes[moveTargetId] && store.notes[moveTargetId].parent === f.id;
    return `<div class="folder-pick-item" data-id="${f.id}" style="${isCurrent?'opacity:0.4':''}">
      <span style="font-size:20px">${f.id==='root'?'🏠':'📁'}</span>
      <span style="flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${indent}${escHtml(f.name)}</span>
      ${isCurrent?'<span style="font-size:11px;color:var(--text-muted)">当前</span>':''}
    </div>`;
  }).join('');
  list.querySelectorAll('.folder-pick-item').forEach(el => {
    if (store.notes[moveTargetId] && store.notes[moveTargetId].parent === el.dataset.id) return;
    el.addEventListener('click', () => doMoveNote(el.dataset.id));
  });
}
function doMoveNote(folderId) {
  if (!moveTargetId || !store.notes[moveTargetId]) return;
  store.notes[moveTargetId].parent = folderId;
  store.notes[moveTargetId].updated = Date.now();
  saveStore();
  document.getElementById('move-modal').classList.remove('show');
  renderFileList(document.getElementById('search-input').value.trim());
  showToast('已移动到 ' + (store.folders[folderId] ? store.folders[folderId].name : '根目录'));
  moveTargetId = null;
}
function flattenFolders(parentId, path) {
  parentId = parentId || 'root';
  path = path || [];
  const results = [];
  const folder = store.folders[parentId];
  if (!folder) return results;
  const entryPath = parentId === 'root' ? [{ id: 'root', name: '根目录' }] : [...path, { id: folder.id, name: folder.name }];
  results.push({ id: parentId, name: parentId === 'root' ? '根目录' : folder.name, path: entryPath });
  (folder.children || []).forEach(cid => results.push(...flattenFolders(cid, entryPath)));
  return results;
}
document.getElementById('move-cancel').addEventListener('click', () => {
  document.getElementById('move-modal').classList.remove('show');
  batchMoveIds = [];
});
document.getElementById('move-modal').addEventListener('click', function(e) { if(e.target===this) this.classList.remove('show'); });

// ===================== EDITOR =====================
let autoSaveTimer = null;

function openNote(id) {
  currentNoteId = id;
  const note = store.notes[id];
  if (!note) return;

  let recent = [];
  try { recent = JSON.parse(localStorage.getItem(RECENT_KEY) || '[]'); } catch(e) {}
  recent = recent.filter(rid => rid !== id && store.notes[rid]);
  recent.unshift(id);
  if (recent.length > 10) recent = recent.slice(0, 10);
  localStorage.setItem(RECENT_KEY, JSON.stringify(recent));

  const titleEl = document.getElementById('note-title');
  titleEl.value = note.title || '';
  autoResizeTitle();

  const content = document.getElementById('note-content');
  content.innerText = note.content || '';
  currentFontSize = note.fontSize || 15;
  document.getElementById('font-size-val').textContent = currentFontSize;
  content.style.fontSize = currentFontSize + 'px';

  updateWordCount();
  document.getElementById('save-status').textContent = '已保存';
  document.getElementById('editor-view').classList.add('active');
  document.getElementById('editor-view').style.display = 'flex';
  closeFindReplace();

  const searchQ = document.getElementById('search-input').value.trim();
  if (searchQ) {
    setTimeout(() => {
      document.getElementById('fr-find').value = searchQ;
      document.getElementById('find-replace-bar').classList.add('show');
      applyFindHighlights();
      if (findMarks.length > 0) navigateToMark(0);
    }, 300);
  } else {
    setTimeout(() => content.focus(), 200);
  }
}

function autoResizeTitle() {
  const el = document.getElementById('note-title');
  el.style.height = 'auto';
  el.style.height = Math.min(el.scrollHeight, 120) + 'px';
}

document.getElementById('note-title').addEventListener('input', () => {
  autoResizeTitle();
  document.getElementById('save-status').textContent = '编辑中…';
  clearTimeout(autoSaveTimer);
  autoSaveTimer = setTimeout(saveCurrentNote, 1500);
});

function closeEditor() {
  saveCurrentNote();
  if (focusMode) {
    focusMode = false;
    document.getElementById('editor-view').classList.remove('focus-mode');
    document.getElementById('focus-exit-btn').classList.remove('show');
    document.getElementById('btn-focus-mode').textContent = '🎯';
  }
  document.getElementById('editor-view').classList.remove('active');
  setTimeout(() => { document.getElementById('editor-view').style.display = 'none'; }, 200);
  closeFindReplace();
  const searchQ = document.getElementById('search-input').value.trim();
  renderFileList(searchQ);
}

function saveCurrentNote() {
  if (!currentNoteId) return;
  const note = store.notes[currentNoteId];
  if (!note) return;
  note.title = document.getElementById('note-title').value;
  note.content = document.getElementById('note-content').innerText;
  note.updated = Date.now();
  note.fontSize = currentFontSize;
  saveStore();
  updateWordCount();
  document.getElementById('save-status').textContent = '已保存 ✓';
}

document.getElementById('editor-back').addEventListener('click', closeEditor);
document.getElementById('editor-quick-back').addEventListener('click', closeEditor);

document.getElementById('note-content').addEventListener('input', () => {
  updateWordCount();
  document.getElementById('save-status').textContent = '编辑中…';
  clearTimeout(autoSaveTimer);
  autoSaveTimer = setTimeout(saveCurrentNote, 1500);
});

// ===================== CAPACITOR PLUGIN HELPERS =====================
function getCapPlugin(name) {
  try {
    if (typeof Capacitor === 'undefined') return null;
    if (Capacitor.Plugins) {
      // Try exact name
      if (Capacitor.Plugins[name]) return Capacitor.Plugins[name];
      // Try case variations
      const keys = Object.keys(Capacitor.Plugins);
      const match = keys.find(k => k.toLowerCase() === name.toLowerCase());
      if (match) return Capacitor.Plugins[match];
      // Debug: log available plugins (runs once)
      if (!getCapPlugin._logged) {
        console.log('Available Capacitor plugins:', keys);
        getCapPlugin._logged = true;
      }
    }
  } catch(e) {}
  return null;
}

// List all Capacitor plugins for debugging
function listCapPlugins() {
  try {
    if (typeof Capacitor !== 'undefined' && Capacitor.Plugins) {
      return Object.keys(Capacitor.Plugins);
    }
  } catch(e) {}
  return [];
}

// ===================== CLIPBOARD =====================
function copyToClipboard(text) {
  if (navigator.clipboard && navigator.clipboard.writeText) {
    return navigator.clipboard.writeText(text).then(() => true).catch(() => fallbackCopy(text));
  }
  return fallbackCopy(text);
}

function fallbackCopy(text) {
  return new Promise((resolve) => {
    const ta = document.createElement('textarea');
    ta.value = text;
    ta.style.position = 'fixed'; ta.style.left = '-9999px'; ta.style.top = '-9999px';
    document.body.appendChild(ta);
    ta.focus(); ta.select();
    try { document.execCommand('copy'); resolve(true); }
    catch(e) { resolve(false); }
    document.body.removeChild(ta);
  });
}

// ===================== SHARE =====================
async function shareText(title, content) {
  const text = (title || '无标题') + (content ? '\n\n' + content : '');
  // Try Web Share API first
  if (navigator.share) {
    try { await navigator.share({ title: title || '成书笔记', text: text }); return; }
    catch(e) { if (e.name === 'AbortError') return; }
  }
  // Try Capacitor Share plugin
  try {
    if (typeof Capacitor !== 'undefined' && Capacitor.Plugins) {
      const s = Capacitor.Plugins.Share || Capacitor.Plugins.share;
      if (s) { await s.share({ title: title || '成书笔记', text: text }); return; }
    }
  } catch(e) {}
  // Fallback: clipboard
  const ok = await copyToClipboard(text);
  showToast(ok ? '✅ 已复制到剪贴板' : '❌ 复制失败');
}

async function shareCurrentNote() {
  if (!currentNoteId || !store.notes[currentNoteId]) { showToast('没有可分享的内容'); return; }
  const n = store.notes[currentNoteId];
  await shareText(n.title, n.content);
}

async function shareNote(id) {
  const n = store.notes[id];
  if (!n) { showToast('便签不存在'); return; }
  await shareText(n.title, n.content);
}

async function shareAllNotes() {
  const allNotes = collectAllNotes();
  if (allNotes.length === 0) { showToast('没有可分享的内容'); return; }
  let content = '';
  allNotes.forEach((n, i) => {
    if (i > 0) content += '\n\n' + '='.repeat(40) + '\n\n';
    content += (n.title || '无标题') + '\n';
    content += '时间：' + new Date(n.updated||n.created).toLocaleString('zh-CN') + '\n\n';
    content += (n.content || '');
  });
  await shareText('成书笔记_全部便签', content);
}

async function shareSelected() {
  const ids = Object.keys(selectedItems);
  if (ids.length === 0) { showToast('请先选择便签'); return; }
  let content = '';
  let count = 0;
  ids.forEach((id) => {
    const item = selectedItems[id];
    if (item.type !== 'note') return;
    const n = item.data;
    if (count > 0) content += '\n\n' + '='.repeat(40) + '\n\n';
    content += (n.title || '无标题') + '\n\n' + (n.content || '');
    count++;
  });
  if (count === 0) { showToast('请选择便签（不能只选文件夹）'); return; }
  await shareText('成书笔记_分享', content);
}

// ===================== FOCUS MODE =====================
let focusMode = false;
document.getElementById('btn-focus-mode').addEventListener('click', function() {
  focusMode = !focusMode;
  const editorView = document.getElementById('editor-view');
  editorView.classList.toggle('focus-mode', focusMode);
  document.getElementById('focus-exit-btn').classList.toggle('show', focusMode);
  this.textContent = focusMode ? '👁' : '🎯';
  this.title = focusMode ? '退出专注模式' : '专注模式';
});

// ===================== OCR 文字识别 =====================
// 加载 Tesseract.js（首次使用时动态加载）
var tesseractLoaded = false;

document.getElementById('btn-ocr').addEventListener('click', async function() {
  var btn = this;
  btn.disabled = true;
  btn.textContent = '⏳';
  
  // 创建图片选择器
  var input = document.createElement('input');
  input.type = 'file';
  input.accept = 'image/*';
  input.onchange = async function(e) {
    var file = e.target.files[0];
    if (!file) { btn.disabled = false; btn.textContent = '📷'; return; }
    
    showToast('正在识别文字，请稍候…');
    
    // 动态加载 Tesseract.js
    if (!tesseractLoaded) {
      try {
        await loadScript('https://cdn.jsdelivr.net/npm/tesseract.js@4/dist/tesseract.min.js');
        tesseractLoaded = true;
      } catch(err) {
        showToast('OCR库加载失败，请检查网络');
        btn.disabled = false; btn.textContent = '📷';
        return;
      }
    }
    
    // 识别文字
    try {
      var result = await Tesseract.recognize(file, 'chi_sim+eng', {
        logger: function() {}
      });
      var text = result.data.text.trim();
      if (!text) {
        showToast('未识别到文字，请确保图片中包含清晰的文字');
        btn.disabled = false; btn.textContent = '📷';
        return;
      }
      // 将识别结果追加到当前便签
      var editor = document.getElementById('note-content');
      var currentText = editor.innerText.trim();
      var insertText = currentText ? '\n\n' + text : text;
      editor.innerHTML = escHtml(currentText + insertText).replace(/\n/g, '<br>');
      saveCurrentNote();
      showToast('文字已提取并追加到便签！');
    } catch(err2) {
      showToast('识别失败：' + err2.message);
    }
    btn.disabled = false; btn.textContent = '📷';
  };
  input.click();
});

// 动态加载JS脚本
function loadScript(src) {
  return new Promise(function(resolve, reject) {
    var s = document.createElement('script');
    s.src = src;
    s.onload = resolve;
    s.onerror = reject;
    document.head.appendChild(s);
  });
}

function updateWordCount() {
  const text = document.getElementById('note-content').innerText;
  const count = text.replace(/\s/g,'').length;
  let folderPath = '';
  if (currentNoteId && store.notes[currentNoteId]) {
    const parentId = store.notes[currentNoteId].parent;
    if (parentId && parentId !== 'root') {
      const path = getPath(parentId);
      folderPath = ' · 📁' + path.map(p => p.name).join('/');
    }
  }
  document.getElementById('editor-info').textContent = count + ' 字' + folderPath;
}

// ===================== FIND & REPLACE =====================
let findIdx = -1, findMarks = [], findQuery = '', findApplied = false;

function closeFindReplace() {
  document.getElementById('find-replace-bar').classList.remove('show');
  document.getElementById('fr-find').value = '';
  document.getElementById('fr-replace').value = '';
  document.getElementById('fr-count').textContent = '';
  findIdx = -1; findMarks = []; findQuery = '';
  clearFindHighlights();
  findApplied = false;
}

function clearFindHighlights() {
  const content = document.getElementById('note-content');
  if (!findApplied) return;
  content.innerHTML = content.innerText;
  findApplied = false;
  findMarks = [];
  findIdx = -1;
}

function applyFindHighlights() {
  const query = document.getElementById('fr-find').value;
  if (!query) { clearFindHighlights(); findMarks = []; findIdx = -1; findQuery = ''; return; }
  const content = document.getElementById('note-content');
  const plainText = findApplied ? content.innerText : content.innerText;
  findQuery = query;
  const escaped = query.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
  const re = new RegExp('(' + escaped + ')', 'gi');
  content.innerHTML = escHtml(plainText).replace(re, '<mark>$1</mark>');
  findApplied = true;
  findMarks = Array.from(content.querySelectorAll('mark'));
  if (findMarks.length === 0) {
    document.getElementById('fr-count').textContent = '0个';
    findIdx = -1;
    return;
  }
  document.getElementById('fr-count').textContent = findMarks.length + '个';
  findIdx = -1;
}

function navigateToMark(idx) {
  if (findMarks.length === 0) return;
  findMarks.forEach(m => m.classList.remove('current'));
  findIdx = ((idx % findMarks.length) + findMarks.length) % findMarks.length;
  const mark = findMarks[findIdx];
  mark.classList.add('current');
  mark.scrollIntoView({ behavior: 'smooth', block: 'center' });
  document.getElementById('fr-count').textContent = (findIdx + 1) + '/' + findMarks.length;
}

document.getElementById('btn-find-replace').addEventListener('click', () => {
  const bar = document.getElementById('find-replace-bar');
  bar.classList.toggle('show');
  if (bar.classList.contains('show')) document.getElementById('fr-find').focus();
  else closeFindReplace();
});

document.getElementById('fr-find').addEventListener('input', () => {
  const q = document.getElementById('fr-find').value;
  if (!q) { clearFindHighlights(); document.getElementById('fr-count').textContent = ''; findMarks = []; findIdx = -1; findQuery = ''; return; }
  if (q !== findQuery) applyFindHighlights();
  if (findMarks.length > 0) navigateToMark(0);
});

document.getElementById('fr-next').addEventListener('click', () => {
  if (findMarks.length === 0) applyFindHighlights();
  if (findMarks.length > 0) navigateToMark(findIdx + 1);
});
document.getElementById('fr-prev').addEventListener('click', () => {
  if (findMarks.length === 0) applyFindHighlights();
  if (findMarks.length > 0) navigateToMark(findIdx - 1);
});

document.getElementById('fr-replace-one').addEventListener('click', () => {
  const find = document.getElementById('fr-find').value;
  const replace = document.getElementById('fr-replace').value;
  if (!find || findMarks.length === 0) return;
  const content = document.getElementById('note-content');
  const marks = content.querySelectorAll('mark');
  if (findIdx < 0 || findIdx >= marks.length) return;
  marks[findIdx].replaceWith(document.createTextNode(replace));
  findApplied = true;
  saveCurrentNote();
  updateWordCount();
  applyFindHighlights();
  if (findMarks.length > 0) navigateToMark(Math.min(findIdx, findMarks.length - 1));
});

document.getElementById('fr-replace-all').addEventListener('click', () => {
  const find = document.getElementById('fr-find').value;
  const replace = document.getElementById('fr-replace').value;
  if (!find) return;
  const content = document.getElementById('note-content');
  const marks = content.querySelectorAll('mark');
  const count = marks.length;
  marks.forEach(m => m.replaceWith(document.createTextNode(replace)));
  document.getElementById('fr-count').textContent = '已替换' + count + '处';
  saveCurrentNote();
  updateWordCount();
  findMarks = []; findIdx = -1; findQuery = ''; findApplied = false;
});

document.getElementById('note-content').addEventListener('input', () => {
  if (findApplied) { findApplied = false; findMarks = []; findIdx = -1; }
});

document.getElementById('fr-close').addEventListener('click', closeFindReplace);
document.getElementById('fr-find').addEventListener('keydown', e => {
  if (e.key==='Enter') {
    if (findMarks.length === 0) applyFindHighlights();
    if (findMarks.length > 0) navigateToMark(findIdx + 1);
  }
});

// ===================== TOOLBAR =====================
document.getElementById('font-inc').addEventListener('click', () => {
  if (currentFontSize < 32) {
    currentFontSize++;
    document.getElementById('font-size-val').textContent = currentFontSize;
    document.getElementById('note-content').style.fontSize = currentFontSize + 'px';
    saveCurrentNote();
  }
});
document.getElementById('font-dec').addEventListener('click', () => {
  if (currentFontSize > 10) {
    currentFontSize--;
    document.getElementById('font-size-val').textContent = currentFontSize;
    document.getElementById('note-content').style.fontSize = currentFontSize + 'px';
    saveCurrentNote();
  }
});

let boldOn=false, italicOn=false, underlineOn=false;
document.getElementById('tb-bold').addEventListener('click', function() {
  boldOn=!boldOn; this.classList.toggle('active',boldOn);
  document.getElementById('note-content').style.fontWeight = boldOn?'700':'400';
});
document.getElementById('tb-italic').addEventListener('click', function() {
  italicOn=!italicOn; this.classList.toggle('active',italicOn);
  document.getElementById('note-content').style.fontStyle = italicOn?'italic':'normal';
});
document.getElementById('tb-underline').addEventListener('click', function() {
  underlineOn=!underlineOn; this.classList.toggle('active',underlineOn);
  document.getElementById('note-content').style.textDecoration = underlineOn?'underline':'none';
});

// ===================== EXPORT CONFIRM DIALOG =====================
// 显示导出确认对话框（底部弹出），点确定后执行真正的导出
// type: 'txt' | 'docx'
function showExportConfirmDialog(title, filename, getContentFn, type) {
  hideBottomSheet();
  const overlay = document.createElement('div');
  overlay.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,0.5);z-index:200;display:flex;align-items:flex-end;justify-content:center;';
  const icon = type === 'docx' ? '📄' : '💾';
  const formatLabel = type === 'docx' ? 'DOCX 格式' : 'TXT 格式';
  overlay.innerHTML = `
    <div style="background:var(--surface,#fff);border-radius:20px 20px 0 0;padding:24px 20px 36px;width:100%;max-width:430px;animation:slideUp 0.3s ease;">
      <div style="width:36px;height:4px;background:#ccc;border-radius:2px;margin:0 auto 20px;"></div>
      <div style="text-align:center;font-size:40px;margin-bottom:12px;">${icon}</div>
      <div style="font-size:17px;font-weight:700;color:var(--text,#1A1A2E);text-align:center;margin-bottom:8px;">确认导出？</div>
      <div style="font-size:13px;color:var(--text-muted,#888);text-align:center;margin-bottom:20px;">即将导出为 ${formatLabel}</div>
      <div style="background:var(--bg,#F5F5F7);border-radius:12px;padding:14px 16px;margin-bottom:20px;">
        <div style="font-size:12px;color:var(--text-muted,#888);margin-bottom:4px;">文件名</div>
        <div style="font-size:14px;font-weight:600;color:var(--text,#1A1A2A);word-break:break-all;">${escHtml(filename)}</div>
        ${title ? '<div style="font-size:12px;color:var(--text-muted,#888);margin-top:8px;margin-bottom:4px;">来源</div><div style="font-size:14px;font-weight:600;color:var(--text,#1A1A2A);word-break:break-all;">' + escHtml(title) + '</div>' : ''}
      </div>
      <button id="export-confirm-btn" style="width:100%;padding:14px;border-radius:14px;border:none;background:#6C63FF;color:white;font-size:15px;font-weight:600;cursor:pointer;margin-bottom:10px;">确定导出</button>
      <button id="export-cancel-btn" style="width:100%;padding:14px;border-radius:14px;border:1px solid var(--border,#DDD);background:transparent;color:var(--text,#1A1A2E);font-size:15px;font-weight:600;cursor:pointer;">取消</button>
    </div>`;
  overlay.setAttribute('data-export-confirm', '1');
  overlay.addEventListener('click', function(e){ if(e.target===this) this.remove(); });
  document.getElementById('app').appendChild(overlay);
  document.getElementById('export-confirm-btn').addEventListener('click', function() {
    overlay.remove();
    // 执行真正的导出
    const content = getContentFn();
    if (type === 'docx') {
      downloadDocxFile(filename, content);
    } else {
      downloadFile(filename, content, 'text/plain;charset=utf-8');
    }
  });
  document.getElementById('export-cancel-btn').addEventListener('click', function() {
    overlay.remove();
  });
}

// ===================== DOCX GENERATOR (无外部依赖) =====================
// 简单的 DOCX 生成器，把内容转成标准 .docx 文件（ZIP+XML）
function generateDocxContent(title, paragraphs) {
  // paragraphs: [{title, content, time}]
  const escapeXml = function(str) {
    if (!str) return '';
    return String(str)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/\"/g, '&quot;');
  };

  const bodyContent = paragraphs.map(function(p, idx) {
    var titleXml = p.title ? '<w:p><w:pPr><w:pStyle w:val="Heading1"/></w:pPr><w:r><w:rPr><w:b/><w:sz w:val="28"/></w:rPr><w:t xml:space="preserve">' + escapeXml(p.title) + '</w:t></w:r></w:p>' : '';
    var timeXml = p.time ? '<w:p><w:pPr><w:pStyle w:val="Caption"/></w:pPr><w:r><w:rPr><w:color w:val="888888"/><w:sz w:val="18"/></w:rPr><w:t xml:space="preserve">' + escapeXml(p.time) + '</w:t></w:r></w:p>' : '';
    var contentLines = (p.content || '').split('\n');
    var contentXml = contentLines.map(function(line) {
      return '<w:p><w:r><w:t xml:space="preserve">' + escapeXml(line) + '</w:t></w:r></w:p>';
    }).join('');
    return titleXml + timeXml + contentXml;
  }).join('<w:p><w:pPr><w:pBdr><w:bottom w:val="single" w:sz="4" w:space="1" w:color="CCCCCC"/></w:pBdr></w:pPr></w:p>');

  var bodyXml = '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>\n' +
    '<w:document xmlns:wpc="http://schemas.microsoft.com/office/word/2010/wordprocessingCanvas" ' +
    'xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" ' +
    'xmlns:o="urn:schemas-microsoft-com:office:office" ' +
    'xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" ' +
    'xmlns:m="http://schemas.openxmlformats.org/officeDocument/2006/math" ' +
    'xmlns:v="urn:schemas-microsoft-com:vml" ' +
    'xmlns:wp14="http://schemas.microsoft.com/office/word/2010/wordprocessingDrawing" ' +
    'xmlns:wp="http://schemas.openxmlformats.org/drawingml/2006/wordprocessingDrawing" ' +
    'xmlns:w10="urn:schemas-microsoft-com:office:word" ' +
    'xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" ' +
    'xmlns:w14="http://schemas.microsoft.com/office/word/2010/wordml" ' +
    'xmlns:wpg="http://schemas.microsoft.com/office/word/2010/wordprocessingGroup" ' +
    'xmlns:wpi="http://schemas.microsoft.com/office/word/2010/wordprocessingInk" ' +
    'xmlns:wne="http://schemas.microsoft.com/office/word/2006/wordml" ' +
    'xmlns:wps="http://schemas.microsoft.com/office/word/2010/wordprocessingShape" ' +
    'mc:Ignorable="w14 wp14">' +
    '<w:body>' +
    bodyContent +
    '<w:sectPr><w:pgSz w:w="12240" w:h="15840"/><w:pgMar w:top="1440" w:right="1440" w:bottom="1440" w:left="1440" w:header="720" w:footer="720" w:gutter="0"/></w:sectPr>' +
    '</w:body></w:document>';

  // 构建 word/styles.xml
  var stylesXml = '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>\n' +
    '<w:styles xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main">' +
    '<w:docDefaults><w:rPrDefault><w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:rPrDefault></w:docDefaults>' +
    '<w:style w:type="paragraph" w:styleId="Normal"><w:name w:val="Normal"/><w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial"/><w:sz w:val="24"/></w:rPr></w:style>' +
    '<w:style w:type="paragraph" w:styleId="Heading1"><w:name w:val="heading 1"/><w:basedOn w:val="Normal"/><w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial"/><w:b/><w:sz w:val="28"/><w:color w:val="1A1A2E"/></w:rPr><w:pPr><w:spacing w:before="240" w:after="120"/></w:pPr></w:style>' +
    '<w:style w:type="paragraph" w:styleId="Caption"><w:name w:val="caption"/><w:basedOn w:val="Normal"/><w:rPr><w:color w:val="888888"/><w:sz w:val="18"/></w:rPr></w:style>' +
    '</w:styles>';

  // 构建 [Content_Types].xml
  var contentTypes = '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>\n' +
    '<Types xmlns="http://schemas.openxmlformats.org/package/2006/content-types">' +
    '<Default Extension="rels" ContentType="application/vnd.openxmlformats-package.relationships+xml"/>' +
    '<Default Extension="xml" ContentType="application/xml"/>' +
    '<Override PartName="/word/document.xml" ContentType="application/vnd.openxmlformats-officedocument.wordprocessingml.document.main+xml"/>' +
    '<Override PartName="/word/styles.xml" ContentType="application/vnd.openxmlformats-officedocument.wordprocessingml.styles+xml"/>' +
    '</Types>';

  // 构建 _rels/.rels
  var rels = '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>\n' +
    '<Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships">' +
    '<Relationship Id="rId1" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/officeDocument" Target="word/document.xml"/>' +
    '</Relationships>';

  // 构建 word/_rels/document.xml.rels
  var docRels = '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>\n' +
    '<Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships">' +
    '<Relationship Id="rId1" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/styles" Target="styles.xml"/>' +
    '</Relationships>';

  return {
    '[Content_Types].xml': contentTypes,
    '_rels/.rels': rels,
    'word/document.xml': bodyXml,
    'word/_rels/document.xml.rels': docRels,
    'word/styles.xml': stylesXml
  };
}

// 使用 JSZip 生成 DOCX 文件并下载（无外部库，用纯 JS 构造 ZIP）
async function downloadDocxFile(filename, paragraphs) {
  var zipData = generateDocxContent(filename, paragraphs);
  var zip = await createZipBlob(zipData);
  var blob = new Blob([zip], { type: 'application/vnd.openxmlformats-officedocument.wordprocessingml.document' });
  // 在 Capacitor 环境下通过文件系统保存
  if (isCapacitor()) {
    var reader = new FileReader();
    reader.onload = function() {
      var base64 = reader.result.split(',')[1];
      var FS = Capacitor.Plugins && (Capacitor.Plugins.Filesystem || Capacitor.Plugins.filesystem);
      if (!FS) {
        // 回退：直接下载 blob
        downloadBlobFile(blob, filename);
        showToast('DOCX 已生成（部分浏览器不支持）');
        return;
      }
      var strategies = [
        { path: 'Download/' + filename, directory: 'EXTERNAL_STORAGE', label: 'Download/' + filename },
        { path: 'Downloads/' + filename, directory: 'EXTERNAL_STORAGE', label: 'Downloads/' + filename },
        { path: filename, directory: 'EXTERNAL', label: '外部存储/' + filename },
        { path: filename, directory: 'DOCUMENTS', label: '文档/' + filename },
        { path: filename, directory: 'DATA', label: '应用数据/' + filename },
      ];
      (async function tryWrite(i) {
        if (i >= strategies.length) {
          // 全部失败，保存到应用目录
          try {
            await FS.writeFile({ path: filename, data: base64, directory: 'DOCUMENTS', recursive: true });
            showExportSuccessDialog(filename, '文档/' + filename, true);
          } catch(e2) {
            downloadBlobFile(blob, filename);
            showToast('保存失败，已使用浏览器下载');
          }
          return;
        }
        var s = strategies[i];
        try {
          await FS.writeFile({ path: s.path, data: base64, directory: s.directory, recursive: true });
          showExportSuccessDialog(filename, s.label, true);
        } catch(e) {
          tryWrite(i + 1);
        }
      })(0);
    };
    reader.readAsDataURL(blob);
  } else {
    downloadBlobFile(blob, filename);
    showToast('DOCX 已下载');
  }
}

// 纯 JS 构造 ZIP 文件（使用标准 DEFLATE 压缩，兼容所有现代浏览器）
async function createZipBlob(files) {
  var parts = [];
  var centralDir = [];
  var offset = 0;

  function crc32(data) {
    var table = new Int32Array(256);
    for (var i = 0; i < 256; i++) {
      var c = i;
      for (var j = 0; j < 8; j++) {
        c = (c & 1) ? (0xEDB88320 ^ (c >>> 1)) : (c >>> 1);
      }
      table[i] = c;
    }
    var crc = -1;
    for (var k = 0; k < data.length; k++) {
      crc = table[(crc ^ data[k]) & 0xFF] ^ (crc >>> 8);
    }
    return (crc ^ -1) >>> 0;
  }

  for (var name in files) {
    var content = files[name];
    var byteContent;
    if (typeof content === 'string') {
      byteContent = new TextEncoder().encode(content);
    } else {
      byteContent = new Uint8Array(content);
    }
    // 使用 pako 进行真正的 DEFLATE 压缩
    var compressed = pako.deflate(byteContent);
    var crc = crc32(byteContent);
    var nameBytes = new TextEncoder().encode(name);
    var localEntry = new Uint8Array([
      0x50, 0x4B, 0x03, 0x04, // local file header signature
      0x14, 0x00, // version needed to extract (2.0)
      0x00, 0x00, // general purpose bit flag
      0x08, 0x00, // compression method (8 = DEFLATE)
      0x00, 0x00, // last mod file time
      0x00, 0x00, // last mod file date
      crc & 0xFF, (crc >> 8) & 0xFF, (crc >> 16) & 0xFF, (crc >> 24) & 0xFF, // crc-32
      compressed.length & 0xFF, ((compressed.length >> 8)) & 0xFF, ((compressed.length >> 16)) & 0xFF, ((compressed.length >> 24)) & 0xFF, // compressed size
      byteContent.length & 0xFF, ((byteContent.length >> 8)) & 0xFF, ((byteContent.length >> 16)) & 0xFF, ((byteContent.length >> 24)) & 0xFF, // uncompressed size
      nameBytes.length & 0xFF, ((nameBytes.length >> 8)) & 0xFF, // file name length
      0, 0, // extra field length
    ]);
    var entry = new Uint8Array(localEntry.length + nameBytes.length + compressed.length);
    entry.set(localEntry, 0);
    entry.set(nameBytes, localEntry.length);
    entry.set(compressed, localEntry.length + nameBytes.length);
    centralDir.push({
      offset: offset,
      crc: crc,
      compSize: compressed.length,
      uncompSize: byteContent.length,
      nameLen: nameBytes.length,
      name: name
    });
    parts.push(entry);
    offset += entry.length;
  }

  var cdOffset = offset;
  for (var i = 0; i < centralDir.length; i++) {
    var e = centralDir[i];
    var nameBytes2 = new TextEncoder().encode(e.name);
    var cdEntry = new Uint8Array([
      0x50, 0x4B, 0x01, 0x02, // central dir header signature
      0x14, 0x00, // version made by
      0x14, 0x00, // version needed to extract
      0x00, 0x00, // general purpose bit flag
      0x08, 0x00, // compression method (8 = DEFLATE)
      0x00, 0x00, // last mod file time
      0x00, 0x00, // last mod file date
      e.crc & 0xFF, (e.crc >> 8) & 0xFF, (e.crc >> 16) & 0xFF, (e.crc >> 24) & 0xFF,
      e.compSize & 0xFF, ((e.compSize >> 8)) & 0xFF, ((e.compSize >> 16)) & 0xFF, ((e.compSize >> 24)) & 0xFF,
      e.uncompSize & 0xFF, ((e.uncompSize >> 8)) & 0xFF, ((e.uncompSize >> 16)) & 0xFF, ((e.uncompSize >> 24)) & 0xFF,
      e.nameLen & 0xFF, ((e.nameLen >> 8)) & 0xFF,
      0, 0, // extra field length
      0, 0, // file comment length
      0, 0, // disk number start
      0, 0, // internal file attributes
      0, 0, 0, 0, // external file attributes
      e.offset & 0xFF, ((e.offset >> 8)) & 0xFF, ((e.offset >> 16)) & 0xFF, ((e.offset >> 24)) & 0xFF,
    ]);
    var fullCdEntry = new Uint8Array(cdEntry.length + e.nameLen);
    fullCdEntry.set(cdEntry, 0);
    fullCdEntry.set(nameBytes2, cdEntry.length);
    parts.push(fullCdEntry);
    offset += fullCdEntry.length;
  }

  var cdLen = offset - cdOffset;
  var eocd = new Uint8Array([
    0x50, 0x4B, 0x05, 0x06, // end of central dir signature
    0x00, 0x00, // disk number
    0x00, 0x00, // disk with central dir
    centralDir.length & 0xFF, ((centralDir.length >> 8)) & 0xFF,
    centralDir.length & 0xFF, ((centralDir.length >> 8)) & 0xFF,
    cdLen & 0xFF, ((cdLen >> 8)) & 0xFF, ((cdLen >> 16)) & 0xFF, ((cdLen >> 24)) & 0xFF,
    cdOffset & 0xFF, ((cdOffset >> 8)) & 0xFF, ((cdOffset >> 16)) & 0xFF, ((cdOffset >> 24)) & 0xFF,
    0, 0, // comment length
  ]);
  parts.push(eocd);

  var totalLen = 0;
  for (var pi = 0; pi < parts.length; pi++) totalLen += parts[pi].length;
  var result = new Uint8Array(totalLen);
  var pos = 0;
  for (var pj = 0; pj < parts.length; pj++) {
    result.set(parts[pj], pos);
    pos += parts[pj].length;
  }
  return result;
}

// Blob 下载（网页端回退）
function downloadBlobFile(blob, filename) {
  var url = URL.createObjectURL(blob);
  var a = document.createElement('a');
  a.href = url;
  a.download = filename;
  document.body.appendChild(a);
  a.click();
  setTimeout(function() {
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
  }, 100);
}

// 导出单条便签（调整：先弹出确认框）
function exportNote(id) {
  var n = store.notes[id];
  if (!n) { showToast('便签不存在'); return; }
  showExportConfirmDialog(
    n.title || '无标题',
    (n.title || '便签') + '.docx',
    function() {
      return [{ title: n.title || '无标题', content: n.content || '', time: '创建：' + new Date(n.created || Date.now()).toLocaleString('zh-CN') }];
    },
    'docx'
  );
}

// 导出全部便签（调整：先弹出确认框）
function exportAll() {
  var allNotes = collectAllNotes();
  if (allNotes.length === 0) { showToast('没有可导出的内容'); return; }
  var paras = allNotes.map(function(n) {
    return {
      title: n.title || '无标题',
      content: n.content || '',
      time: '时间：' + new Date(n.updated || n.created).toLocaleString('zh-CN')
    };
  });
  showExportConfirmDialog(
    '全部便签（' + allNotes.length + ' 条）',
    '成书笔记_全部导出.docx',
    function() { return paras; },
    'docx'
  );
}

// 导出文件夹（调整：先弹出确认框）
function exportFolder(folderId) {
  var folder = store.folders[folderId];
  if (!folder) { showToast('文件夹不存在'); return; }
  var notes = collectFolderNotes(folderId);
  if (notes.length === 0) { showToast('文件夹内没有便签可导出'); return; }
  var paras = notes.map(function(n) {
    return {
      title: n.title || '无标题',
      content: n.content || '',
      time: '时间：' + new Date(n.updated || n.created).toLocaleString('zh-CN')
    };
  });
  showExportConfirmDialog(
    folder.name + '（' + notes.length + ' 条便签）',
    folder.name + '_导出.docx',
    function() { return paras; },
    'docx'
  );
}

// 导出 TXT 版本（保留独立函数，供确认框回调使用）
function exportNoteTxt(id) {
  var n = store.notes[id];
  if (!n) { showToast('便签不存在'); return; }
  var content = (n.title || '无标题') + '\n\n' + (n.content || '');
  downloadFile((n.title || '便签') + '.txt', content, 'text/plain;charset=utf-8');
}
function exportFolderTxt(folderId) {
  var folder = store.folders[folderId];
  if (!folder) { showToast('文件夹不存在'); return; }
  var notes = collectFolderNotes(folderId);
  if (notes.length === 0) { showToast('文件夹内没有便签可导出'); return; }
  var content = '📁 文件夹：' + folder.name + '\n';
  content += '导出时间：' + new Date().toLocaleString('zh-CN') + '\n';
  content += '便签数量：' + notes.length + ' 条\n';
  content += '='.repeat(40) + '\n\n';
  notes.forEach(function(n, i) {
    if (i > 0) content += '\n' + '='.repeat(40) + '\n\n';
    content += (n.title || '无标题') + '\n';
    content += '时间：' + new Date(n.updated || n.created).toLocaleString('zh-CN') + '\n\n';
    content += (n.content || '');
  });
  downloadFile(folder.name + '_导出.txt', content, 'text/plain;charset=utf-8');
}
function exportAllTxt() {
  var allNotes = collectAllNotes();
  if (allNotes.length === 0) { showToast('没有可导出的内容'); return; }
  var content = '';
  allNotes.forEach(function(n, i) {
    if (i > 0) content += '\n\n' + '='.repeat(40) + '\n\n';
    content += (n.title || '无标题') + '\n';
    content += '时间：' + new Date(n.updated||n.created).toLocaleString('zh-CN') + '\n\n';
    content += (n.content || '');
  });
  downloadFile('成书笔记_全部导出.txt', content, 'text/plain;charset=utf-8');
}

// 将UTF-8字符串编码为base64（支持中文）
function utf8ToBase64(str) {
  const bytes = new TextEncoder().encode(str);
  let binStr = '';
  bytes.forEach(b => binStr += String.fromCharCode(b));
  return btoa(binStr);
}

// 显示"导出成功"的提示弹窗，告知用户文件保存路径
// isDocx: boolean，true=显示DOCX图标
function showExportSuccessDialog(filename, location, isDocx) {
  // 先关闭其他可能打开的弹层
  hideBottomSheet();
  // 动态创建提示弹窗
  var overlay = document.createElement('div');
  overlay.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,0.5);z-index:200;display:flex;align-items:flex-end;justify-content:center;';
  var icon = isDocx ? '📄' : '💾';
  var formatLabel = isDocx ? 'DOCX 文档' : 'TXT 文件';
  overlay.innerHTML = '<div style="background:var(--surface,#fff);border-radius:20px 20px 0 0;padding:24px 20px 36px;width:100%;max-width:430px;animation:slideUp 0.3s ease;">' +
    '<div style="width:36px;height:4px;background:#ccc;border-radius:2px;margin:0 auto 20px;"></div>' +
    '<div style="text-align:center;font-size:40px;margin-bottom:12px;">' + icon + '</div>' +
    '<div style="font-size:17px;font-weight:700;color:var(--text,#1A1A2E);text-align:center;margin-bottom:8px;">导出成功</div>' +
    '<div style="font-size:13px;color:var(--text-muted,#888);text-align:center;margin-bottom:16px;">文件已保存到手机</div>' +
    '<div style="background:var(--bg,#F5F5F7);border-radius:12px;padding:14px 16px;margin-bottom:16px;">' +
      '<div style="font-size:12px;color:var(--text-muted,#888);margin-bottom:4px;">文件名</div>' +
      '<div style="font-size:14px;font-weight:600;color:var(--text,#1A1A2E);word-break:break-all;">' + escHtml(filename) + '</div>' +
      '<div style="font-size:12px;color:var(--text-muted,#888);margin-top:8px;margin-bottom:4px;">保存位置</div>' +
      '<div id="export-path-text" style="font-size:13px;color:#6C63FF;word-break:break-all;cursor:pointer;text-decoration:underline;" title="点击打开文件所在位置">' + escHtml(location) + '</div>' +
    '</div>' +
    '<button id="export-open-btn" style="width:100%;padding:14px;border-radius:14px;border:none;background:#6C63FF;color:white;font-size:15px;font-weight:600;cursor:pointer;margin-bottom:10px;">📂 打开文件位置</button>' +
    '<button id="export-ok-btn" onclick="this.closest(\'[data-export-dialog]\').remove()" style="width:100%;padding:14px;border-radius:14px;border:1px solid var(--border,#DDD);background:transparent;color:var(--text,#1A1A2E);font-size:15px;font-weight:600;cursor:pointer;">确定</button>' +
    '</div>';
  overlay.setAttribute('data-export-dialog', '1');
  overlay.addEventListener('click', function(e) { if (e.target === this) this.remove(); });
  document.getElementById('app').appendChild(overlay);

  // 点击路径文字 或 打开文件位置按钮 → 调用系统打开文件
  function openFileLocation() {
    var sharePlugin = Capacitor && Capacitor.Plugins && (Capacitor.Plugins.Share || Capacitor.Plugins.share);
    if (sharePlugin) {
      // 用 Share API 打开文件，系统会自动选择合适的应用（文件管理器）来显示
      var FS = Capacitor.Plugins && (Capacitor.Plugins.Filesystem || Capacitor.Plugins.filesystem);
      if (FS) {
        // 先读取文件，再用 Share 分享文件（触发文件管理器打开）
        (function() {
          var strategies = [
            { path: location.indexOf('Download') !== -1 ? 'Download/' + filename : location.indexOf('Downloads') !== -1 ? 'Downloads/' + filename : filename,
              directory: 'EXTERNAL_STORAGE', label: location },
            { path: filename, directory: 'EXTERNAL', label: location },
            { path: filename, directory: 'DOCUMENTS', label: location },
          ];
          (function tryRead(i) {
            if (i >= strategies.length) {
              // 无法读取文件，直接用路径文字提示用户
              showToast('📂 请到文件管理中打开：' + location);
              return;
            }
            var s = strategies[i];
            FS.readFile({ path: s.path, directory: s.directory, encoding: 'utf8' }).then(function(content) {
              // 文件存在，用 Share 打开
              FS.getUri({ path: s.path, directory: s.directory }).then(function(uriResult) {
                sharePlugin.share({
                  title: filename,
                  url: uriResult.uri
                }).catch(function() {
                  showToast('📂 请到文件管理中打开：' + location);
                });
              }).catch(function() {
                showToast('📂 请到文件管理中打开：' + location);
              });
            }).catch(function() {
              tryRead(i + 1);
            });
          })(0);
        })();
      } else {
        showToast('📂 请到文件管理中打开：' + location);
      }
    } else {
      showToast('📂 请到文件管理中打开：' + location);
    }
  }

  document.getElementById('export-open-btn').addEventListener('click', openFileLocation);
  document.getElementById('export-path-text').addEventListener('click', openFileLocation);
}

async function downloadFile(filename, content, mimeType) {
  if (isCapacitor()) {
    const base64 = utf8ToBase64(content);
    const FS = (Capacitor.Plugins && (Capacitor.Plugins.Filesystem || Capacitor.Plugins.filesystem));
    if (!FS) {
      // Filesystem插件未安装，回退到分享
      showToast('💡 即将打开分享，请选择「保存到文件」');
      setTimeout(() => {
        const sharePlugin = Capacitor.Plugins && (Capacitor.Plugins.Share || Capacitor.Plugins.share);
        if (sharePlugin) {
          sharePlugin.share({ title: filename, text: content, dialogTitle: '保存便签文件' }).catch(()=>{});
        } else if (navigator.share) {
          navigator.share({ title: filename, text: content }).catch(()=>{});
        } else {
          copyToClipboard(content).then(()=>showToast('📋 内容已复制，请手动粘贴保存'));
        }
      }, 400);
      return;
    }

    // 策略1：写入 ExternalStorage（手机内部存储 Download 文件夹）
    const strategies = [
      { path: 'Download/' + filename,   directory: 'EXTERNAL_STORAGE', label: 'Download/' + filename },
      { path: 'Downloads/' + filename,  directory: 'EXTERNAL_STORAGE', label: 'Downloads/' + filename },
      { path: filename,                  directory: 'EXTERNAL',         label: '外部存储/' + filename },
      { path: filename,                  directory: 'DOCUMENTS',        label: '文档/' + filename },
      { path: filename,                  directory: 'DATA',             label: '应用数据/' + filename },
    ];

    for (const s of strategies) {
      try {
        await FS.writeFile({ path: s.path, data: base64, directory: s.directory, recursive: true });
        showExportSuccessDialog(filename, s.label, filename.endsWith('.docx'));
        return;
      } catch(e) {
        // 继续尝试下一个策略
      }
    }

    // 所有策略都失败 → 通过分享保存
    showToast('💡 请在分享面板中选择「保存到文件」');
    setTimeout(() => {
      const sharePlugin = Capacitor.Plugins && (Capacitor.Plugins.Share || Capacitor.Plugins.share);
      if (sharePlugin) {
        sharePlugin.share({ title: filename, text: content, dialogTitle: '保存便签文件' }).catch(()=>{});
      } else if (navigator.share) {
        navigator.share({ title: filename, text: content }).catch(()=>{});
      } else {
        copyToClipboard(content).then(ok => showToast(ok ? '📋 内容已复制到剪贴板' : '❌ 导出失败，请重试'));
      }
    }, 500);
  } else {
    // 网页端：使用Blob下载
    const blob = new Blob(['\uFEFF' + content], { type: mimeType || 'text/plain;charset=utf-8' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url; a.download = filename;
    document.body.appendChild(a); a.click();
    setTimeout(() => { document.body.removeChild(a); URL.revokeObjectURL(url); }, 200);
    showToast('✅ 文件已下载：' + filename);
  }
}

document.getElementById('btn-export-all').addEventListener('click', exportAll);

// ===================== SEARCH =====================
document.getElementById('search-input').addEventListener('input', function() {
  renderFileList(this.value);
});

// ===================== SORT =====================
document.getElementById('btn-sort').addEventListener('click', function() {
  sortOrder = sortOrder === 'date' ? 'name' : 'date';
  localStorage.setItem('chengshu_sort', sortOrder);
  this.textContent = sortOrder === 'date' ? '按时间' : '按名称';
  renderFileList(document.getElementById('search-input').value.trim());
});

// ===================== DARK MODE =====================
const btnDarkMode = document.getElementById('btn-dark-mode');
if (localStorage.getItem('chengshu_dark') === '1') {
  darkMode = true;
  document.body.classList.add('dark');
  btnDarkMode.textContent = '☀️';
}
btnDarkMode.addEventListener('click', () => {
  darkMode = !darkMode;
  document.body.classList.toggle('dark', darkMode);
  localStorage.setItem('chengshu_dark', darkMode ? '1' : '0');
  btnDarkMode.textContent = darkMode ? '☀️' : '🌙';
  const content = document.getElementById('note-content');
  if (content) content.style.color = darkMode ? '#E4E4F0' : '#1A1A2E';
});

// ===================== TOAST =====================
let toastTimer = null;
function showToast(msg) {
  const toast = document.getElementById('toast');
  toast.textContent = msg;
  toast.classList.add('show');
  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => toast.classList.remove('show'), 2500);
}

// ===================== PWA =====================
if ('serviceWorker' in navigator) {
  window.addEventListener('load', () => {
    navigator.serviceWorker.register('sw.js').catch(() => {});
  });
}

// ===================== SELECT MODE =====================
function toggleSelectMode() {
  selectMode = !selectMode;
  if (!selectMode) selectedItems = {};
  document.getElementById('sel-toolbar').classList.toggle('show', selectMode);
  document.getElementById('sel-count').style.display = selectMode ? 'block' : 'none';
  document.getElementById('btn-select-mode').textContent = selectMode ? '☑️' : '☑';
  document.getElementById('btn-select-mode').style.background = selectMode ? 'var(--primary-light)' : '';
  updateSelCount();
  renderFileList(document.getElementById('search-input').value.trim());
}

function toggleSelectItem(id, type, el) {
  if (!selectMode) return;
  const isSelected = !!selectedItems[id];
  if (isSelected) {
    delete selectedItems[id];
  } else {
    const data = type === 'folder' ? store.folders[id] : store.notes[id];
    if (data) selectedItems[id] = { type, data };
  }
  updateSelCount();
  // Direct inline style change for IMMEDIATE visual feedback
  if (el) {
    const nowSelected = !isSelected;
    if (nowSelected) {
      const isDark = document.body.classList.contains('dark');
      el.style.setProperty('background', isDark ? '#1B5E20' : '#C8E6C9', 'important');
      el.style.setProperty('border', '2px solid #4CAF50', 'important');
      el.style.setProperty('border-left', '5px solid #4CAF50', 'important');
    } else {
      el.style.removeProperty('background');
      el.style.removeProperty('border');
      el.style.removeProperty('border-left');
    }
    // Also toggle the checkbox inside
    const cb = el.querySelector('.sel-checkbox');
    if (cb) {
      if (nowSelected) {
        cb.style.setProperty('background', '#4CAF50', 'important');
        cb.style.setProperty('border-color', '#388E3C', 'important');
        cb.style.setProperty('color', 'white', 'important');
        cb.textContent = '✓';
      } else {
        cb.style.removeProperty('background');
        cb.style.removeProperty('border-color');
        cb.style.removeProperty('color');
        cb.textContent = '';
      }
    }
  }
}

function updateSelCount() {
  const el = document.getElementById('sel-count');
  const count = Object.keys(selectedItems).length;
  el.textContent = '已选 ' + count + ' 项';
  el.style.display = selectMode ? 'block' : 'none';
}

function exportSelected() {
  const ids = Object.keys(selectedItems).filter(id => selectedItems[id].type === 'note');
  if (ids.length === 0) { showToast('请选择便签导出'); return; }
  if (ids.length === 1) {
    // 单条便签：弹出格式选择（用底部弹出）
    var n = store.notes[ids[0]];
    if (!n) return;
    showExportConfirmDialog(
      n.title || '无标题',
      (n.title || '便签') + '.docx',
      (function(noteId) { return function() {
        var nn = store.notes[noteId];
        return [{ title: nn.title || '无标题', content: nn.content || '', time: '创建：' + new Date(nn.created || Date.now()).toLocaleString('zh-CN') }];
      }; })(ids[0]),
      'docx'
    );
    return;
  }
  // 多条便签：批量导出为 DOCX
  var paras = ids.map(function(id) {
    var n = store.notes[id];
    return { title: n.title || '无标题', content: n.content || '', time: '时间：' + new Date(n.updated || n.created).toLocaleString('zh-CN') };
  });
  showExportConfirmDialog(
    '已选便签（' + ids.length + ' 条）',
    '成书笔记_批量导出.docx',
    function() { return paras; },
    'docx'
  );
}

function deleteSelected() {
  const ids = Object.keys(selectedItems);
  if (ids.length === 0) { showToast('请先选择'); return; }
  const noteCount = ids.filter(id => selectedItems[id].type === 'note').length;
  const folderCount = ids.filter(id => selectedItems[id].type === 'folder').length;
  const parts = [];
  if (noteCount > 0) parts.push(noteCount + ' 篇便签');
  if (folderCount > 0) parts.push(folderCount + ' 个文件夹');
  if (!confirm('确认删除 ' + parts.join('和') + '？此操作不可恢复。')) return;
  ids.forEach(id => {
    if (selectedItems[id].type === 'folder') deleteFolder(id);
    else delete store.notes[id];
  });
  saveStore();
  selectedItems = {};
  toggleSelectMode();
}

function moveSelected() {
  const noteIds = Object.keys(selectedItems).filter(id => selectedItems[id].type === 'note');
  if (noteIds.length === 0) { showToast('请选择便签（文件夹不支持移动）'); return; }
  showBatchMoveModal(noteIds);
}

let batchMoveIds = [];
function showBatchMoveModal(ids) {
  batchMoveIds = ids;
  document.getElementById('move-modal').classList.add('show');
  renderFolderPickListForBatch();
}

function renderFolderPickListForBatch() {
  const list = document.getElementById('folder-pick-list');
  const all = flattenFolders();
  list.innerHTML = all.map(f => {
    const depth = f.path.length - 1;
    const indent = ' '.repeat(depth);
    return `<div class="folder-pick-item" data-id="${f.id}">
      <span style="font-size:20px">${f.id==='root'?'🏠':'📁'}</span>
      <span style="flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${indent}${escHtml(f.name)}</span>
    </div>`;
  }).join('');
  list.querySelectorAll('.folder-pick-item').forEach(el => {
    el.addEventListener('click', () => {
      batchMoveIds.forEach(id => {
        if (store.notes[id]) {
          store.notes[id].parent = el.dataset.id;
          store.notes[id].updated = Date.now();
        }
      });
      saveStore();
      document.getElementById('move-modal').classList.remove('show');
      showToast('已移动 ' + batchMoveIds.length + ' 篇便签');
      batchMoveIds = [];
      selectedItems = {};
      toggleSelectMode();
    });
  });
}

document.getElementById('btn-select-mode').addEventListener('click', toggleSelectMode);
document.getElementById('sel-share').addEventListener('click', shareSelected);
document.getElementById('sel-export').addEventListener('click', exportSelected);
document.getElementById('sel-move').addEventListener('click', moveSelected);
document.getElementById('sel-delete').addEventListener('click', deleteSelected);
document.getElementById('sel-cancel').addEventListener('click', toggleSelectMode);

// ===================== GRID TOGGLE =====================
let gridMode = localStorage.getItem('chengshu_grid') === '1';
const btnGrid = document.getElementById('btn-grid');
if (gridMode) {
  document.getElementById('main-view').classList.add('grid-mode');
  btnGrid.textContent = '☰';
}
btnGrid.addEventListener('click', () => {
