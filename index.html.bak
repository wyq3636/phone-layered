  document.getElementById('editor-view').classList.remove('focus-mode');
  document.getElementById('focus-exit-btn').classList.remove('show');
  document.getElementById('btn-focus-mode').textContent = '🎯';
});

// ===================== FAB DRAGGING =====================
(function() {
  const fab = document.getElementById('fab-container');
  const fabMain = document.getElementById('fab-main');
  const appEl = document.getElementById('app');
  let dragging = false, moved = false;
  let startX = 0, startY = 0, origLeft = 0, origTop = 0;

  function getClientPos(e) {
    if (e.touches) return { x: e.touches[0].clientX, y: e.touches[0].clientY };
    return { x: e.clientX, y: e.clientY };
  }

  function initDrag(e) {
    if (!e.target.closest('#fab-main')) return;
    dragging = true; moved = false;
    const p = getClientPos(e);
    startX = p.x; startY = p.y;
    const fr = fab.getBoundingClientRect();
    const ar = appEl.getBoundingClientRect();
    origLeft = fr.left - ar.left;
    origTop = fr.top - ar.top;
    if (fab.style.right !== 'auto') {
      fab.style.right = 'auto'; fab.style.bottom = 'auto';
      fab.style.left = origLeft + 'px'; fab.style.top = origTop + 'px';
    }
  }

  function doDrag(e) {
    if (!dragging) return;
    const p = getClientPos(e);
    const dx = p.x - startX, dy = p.y - startY;
    if (!moved && Math.abs(dx) < 5 && Math.abs(dy) < 5) return;
    e.preventDefault();
    moved = true;
    fab.classList.add('dragging');
    const ar = appEl.getBoundingClientRect();
    let nl = origLeft + dx, nt = origTop + dy;
    nl = Math.max(0, Math.min(nl, ar.width - fab.offsetWidth));
    nt = Math.max(0, Math.min(nt, ar.height - fab.offsetHeight));
    fab.style.left = nl + 'px'; fab.style.top = nt + 'px';
  }

  function endDrag(e) {
    if (!dragging) return;
    dragging = false;
    fab.classList.remove('dragging');
    if (moved) { e.stopPropagation(); e.preventDefault(); }
  }

  fabMain.addEventListener('mousedown', initDrag);
  fabMain.addEventListener('touchstart', initDrag, { passive: true });
  document.addEventListener('mousemove', doDrag);
  document.addEventListener('touchmove', doDrag, { passive: false });
  document.addEventListener('mouseup', endDrag);
  document.addEventListener('touchend', endDrag);
})();

// ===================== INIT =====================
renderFileList();
updateHeader();
updateQuickBack();
</script>
</body>
</html>